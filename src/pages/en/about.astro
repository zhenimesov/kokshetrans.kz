---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="About Us — Kokshe Trans Logistics" lang="en">
    <div class="page-header">
        <div class="container">
            <h1>About Kokshe Trans Logistics</h1>
            <p>Your reliable partner in logistics and transportation</p>
        </div>
    </div>

    <section class="about-section">
        <div class="container">
            <div class="about-grid">
                <div class="about-text">
                    <h2>Who We Are</h2>
                    <p><strong>Kokshe Trans Logistics</strong> has established itself as a stable and responsible player in the transport and logistics services market of the Republic of Kazakhstan. We specialize in organizing freight transportation by all modes of transport.</p>
                    <p>Our goal is to ensure maximum comfort and safety for our customers when delivering goods, optimizing costs and time resources at every stage of the logistics chain.</p>
                </div>
                <div class="about-stats">
                    <div class="stat-card">
                        <h3>10+</h3>
                        <p>Years of experience</p>
                    </div>
                    <div class="stat-card">
                        <h3>5000+</h3>
                        <p>Shipments delivered</p>
                    </div>
                    <div class="stat-card">
                        <h3>100%</h3>
                        <p>Reliability</p>
                    </div>
                </div>
            </div>

            <div class="mission-vision">
                <div class="card">
                    <h3>Our Mission</h3>
                    <p>Providing high-quality, safe and fast logistics services that contribute to the development of our customers' businesses and strengthen economic ties.</p>
                </div>
                <div class="card">
                    <h3>Our Values</h3>
                    <p>Professionalism, customer focus, transparency in business conduct and strict fulfillment of obligations undertaken.</p>
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    .page-header {
        background-color: var(--primary-color);
        color: white;
        padding: 4rem 0;
        text-align: center;
    }

    .page-header h1 {
        margin: 0 0 1rem 0;
        font-size: 2.5rem;
    }

    .page-header p {
        margin: 0;
        opacity: 0.8;
        font-size: 1.1rem;
    }

    .about-section {
        padding: 5rem 0;
    }

    .about-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 4rem;
        align-items: center;
        margin-bottom: 5rem;
    }

    .about-text h2 {
        color: var(--primary-color);
        font-size: 2rem;
        margin-top: 0;
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .about-text p {
        color: #555;
        line-height: 1.8;
        font-size: 1.15rem;
        margin-bottom: 1.5rem;
    }

    .about-stats {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .stat-card {
        background: var(--bg-light);
        padding: 1.5rem;
        border-radius: 8px;
        text-align: center;
        border-left: 4px solid var(--accent-color);
    }

    .stat-card h3 {
        margin: 0;
        font-size: 2.25rem;
        color: var(--primary-color);
    }

    .stat-card p {
        margin: 0.5rem 0 0 0;
        color: #666;
        font-weight: 500;
    }

    .mission-vision {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 2.5rem;
    }

    .card {
        background: white;
        border: 1px solid #e1e4e8;
        padding: 2.5rem;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }

    .card h3 {
        color: var(--primary-color);
        margin-top: 0;
        margin-bottom: 1rem;
        font-size: 1.5rem;
        text-align: center;
    }

    .card p {
        color: #555;
        line-height: 1.7;
        margin-bottom: 0;
    }

    @media (max-width: 768px) {
        .about-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }
</style>