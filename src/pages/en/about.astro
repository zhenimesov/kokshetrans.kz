---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="About Us — Kokshe Trans Logistics" lang="en">
	<!-- Page Header -->
	<header class="page-header" aria-labelledby="page-title">
		<div class="container">
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<ol>
					<li><a href="/kokshetrans.kz/en">Home</a></li>
					<li aria-current="page">About Us</li>
				</ol>
			</nav>
			<h1 id="page-title" class="page-title">About Us</h1>
			<p class="page-subtitle">Kokshe Trans Logistics LLP — a reliable partner in transport and logistics services across Kazakhstan and beyond</p>
		</div>
	</header>

	<!-- Company Intro -->
	<section class="company-intro" aria-labelledby="intro-title">
		<div class="container">
			<div class="intro-grid">
				<div class="intro-content">
					<h2 id="intro-title" class="section-title-left">Who We Are</h2>
					<div class="intro-text">
						<p>Kokshe Trans Logistics LLP is a dynamically developing transport and logistics company founded in 2020 in Kokshetau. Over the years, we have established ourselves as a reliable partner for businesses of any scale — from small enterprises to large holdings.</p>
						<p>Our mission is to ensure uninterrupted cargo movement, optimize clients' logistics chains, and create value through expertise, technology, and a personalized approach.</p>
						<p>We specialize in international and domestic transportation, customs clearance, warehouse logistics, and comprehensive supply chain management.</p>
					</div>
					<div class="intro-highlights">
						<div class="highlight">
							<span class="highlight-number">5+</span>
							<span class="highlight-label">Years on the Market</span>
						</div>
						<div class="highlight">
							<span class="highlight-number">500+</span>
							<span class="highlight-label">Completed Projects</span>
						</div>
						<div class="highlight">
							<span class="highlight-number">50+</span>
							<span class="highlight-label">Regular Clients</span>
						</div>
						<div class="highlight">
							<span class="highlight-number">15</span>
							<span class="highlight-label">Countries in Geography</span>
						</div>
					</div>
				</div>
				<div class="intro-image" aria-hidden="true">
					<div class="image-wrapper">
						<img src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=800&q=80" alt="Kokshe Trans Logistics Office" loading="lazy">
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Mission & Values -->
	<section class="mission-values" aria-labelledby="values-title">
		<div class="container">
			<header class="section-header">
				<h2 id="values-title" class="section-title">Mission & Values</h2>
				<p class="section-subtitle">Principles that guide our work every day</p>
			</header>
			<div class="values-grid">
				<article class="value-card">
					<div class="value-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
					</div>
					<h3 class="value-title">Reliability</h3>
					<p class="value-description">We fulfill commitments exactly on time. Cargo is delivered intact and safe, and documents are processed without errors or delays.</p>
				</article>
				<article class="value-card">
					<div class="value-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
					</div>
					<h3 class="value-title">Speed</h3>
					<p class="value-description">We respond promptly to requests, select optimal routes, and minimize cargo transit time.</p>
				</article>
				<article class="value-card">
					<div class="value-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
					</div>
					<h3 class="value-title">Partnership</h3>
					<p class="value-description">We build long-term relationships with clients. Your success is our success. Personal manager at every stage.</p>
				</article>
				<article class="value-card">
					<div class="value-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
					</div>
					<h3 class="value-title">Expertise</h3>
					<p class="value-description">Deep knowledge of customs legislation, rail and road tariffs, Incoterms, and international conventions.</p>
				</article>
				<article class="value-card">
					<div class="value-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
					</div>
					<h3 class="value-title">Development</h3>
					<p class="value-description">We implement IT solutions for tracking, WMS systems for warehouses, and automate document flow and analytics.</p>
				</article>
				<article class="value-card">
					<div class="value-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L13.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L10.91 8.26L12 2z"/></svg>
					</div>
					<h3 class="value-title">Quality</h3>
					<p class="value-description">Continuous quality control at all stages: from request to confirmation of cargo receipt by the consignee.</p>
				</article>
			</div>
		</div>
	</section>

	<!-- Key Stats -->
	<section class="key-stats" aria-labelledby="stats-title">
		<div class="container">
			<div class="stats-grid">
				<article class="stat-card">
					<div class="stat-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 15h18M3 9h18M5 3v18M19 3v18"/></svg>
					</div>
					<div class="stat-content">
						<div class="stat-number" data-target="1200">0</div>
						<div class="stat-label">Containers per Year</div>
					</div>
				</article>
				<article class="stat-card">
					<div class="stat-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
					</div>
					<div class="stat-content">
						<div class="stat-number" data-target="15">0</div>
						<div class="stat-label">Countries in Geography</div>
					</div>
				</article>
				<article class="stat-card">
					<svg class="stat-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 13V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v7"/><path d="M3 13h18"/><path d="M5 13v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V13"/></svg>
					<div class="stat-content">
						<div class="stat-number" data-target="12000">0</div>
						<div class="stat-label">Tons of Cargo per Year</div>
					</div>
				</article>
				<article class="stat-card">
					<div class="stat-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
					</div>
					<div class="stat-content">
						<div class="stat-number" data-target="98">0</div>
						<div class="stat-label">% On-time Delivery</div>
					</div>
				</article>
			</div>
		</div>
	</section>

	<!-- Team & Approach -->
	<section class="team-approach" aria-labelledby="team-title">
		<div class="container">
			<div class="approach-grid">
				<div class="approach-content">
					<h2 id="team-title" class="section-title-left">Our Approach</h2>
					<div class="approach-text">
						<p>We understand that logistics is not just moving cargo from point A to point B. It is a complex process requiring coordination of multiple participants, knowledge of legislation, and the ability to handle unforeseen situations.</p>
						<p><strong>Our team</strong> consists of experts with experience at major terminals, customs, railways, and in international transportation. Each client is assigned a personal manager who handles the project from request to closing documents.</p>
						<p><strong>Technology:</strong> we use our own CRM system for order management, GPS tracking of road transport, integration with railway tracking systems, and electronic document management.</p>
						<p><strong>Transparency:</strong> clients get access to a personal account with shipment history, current statuses, document scans, and reports.</p>
					</div>
					<ul class="approach-list">
						<li>
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
							Personal manager 24/7
						</li>
						<li>
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
							Online tracking in personal account
						</li>
						<li>
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
							Transparent pricing with no hidden fees
						</li>
						<li>
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
							Insurance for every shipment
						</li>
						<li>
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
							Contract-based work with VAT
						</li>
					</ul>
				</div>
				<div class="approach-image" aria-hidden="true">
					<div class="image-wrapper">
						<img src="https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=800&q=80" alt="Kokshe Trans Logistics Team" loading="lazy">
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Certifications / Partners -->
	<section class="certifications" aria-labelledby="cert-title">
		<div class="container">
			<header class="section-header">
				<h2 id="cert-title" class="section-title">Our Advantages</h2>
				<p class="section-subtitle">Why market leaders trust us</p>
			</header>
			<div class="cert-grid">
				<div class="cert-item">
					<div class="cert-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
					</div>
					<h3>Licenses & Permits</h3>
					<p>Full package of documents for transportation and forwarding activities in RK and international traffic</p>
				</div>
				<div class="cert-item">
					<div class="cert-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
					</div>
					<h3>Insurance Protection</h3>
					<p>Carrier liability policies and "All Risks" cargo insurance with reliable insurance partners</p>
				</div>
				<div class="cert-item">
					<div class="cert-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
					</div>
					<h3>Own Fleet</h3>
					<p>Own rolling stock and long-term contracts with verified carriers</p>
				</div>
				<div class="cert-item">
					<div class="cert-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
					</div>
					<h3>Warehouse Infrastructure</h3>
					<p>Access to Class A/B terminals and warehouses in Kokshetau, Astana, Almaty and at RF/China borders</p>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="cta-section" aria-labelledby="cta-title">
		<div class="container">
			<div class="cta-content">
				<h2 id="cta-title" class="cta-title">Want to Become Our Partner?</h2>
				<p class="cta-description">Let's discuss your tasks and propose an optimal logistics solution. A personal manager will contact you within 15 minutes.</p>
				<a href="/kokshetrans.kz/en/contacts" class="btn btn-primary btn-lg">Start Cooperation</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* Page Header */
	.page-header {
		background: var(--primary-color);
		color: var(--bg-white);
		padding: 4rem 0;
		position: relative;
		overflow: hidden;
	}

	.page-header::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 60% 50% at 50% 0%, rgba(226, 135, 67, 0.15) 0%, transparent 70%),
			url('https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
		opacity: 0.1;
	}

	.breadcrumb {
		margin-bottom: 1.5rem;
	}

	.breadcrumb ol {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 0;
		font-size: 0.9375rem;
		flex-wrap: wrap;
	}

	.breadcrumb a {
		color: rgba(255,255,255,0.7);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.breadcrumb a:hover { color: var(--accent-color); }

	.breadcrumb li::after {
		content: '/';
		color: rgba(255,255,255,0.4);
		margin-left: 0.5rem;
	}

	.breadcrumb li:last-child::after { display: none; }

	.breadcrumb li[aria-current="page"] {
		color: var(--bg-white);
		font-weight: 500;
	}

	.page-title {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 800;
		margin: 0 0 1rem;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.page-subtitle {
		font-size: 1.125rem;
		color: rgba(255,255,255,0.8);
		margin: 0;
		max-width: 700px;
		line-height: 1.7;
	}

	/* Company Intro */
	.company-intro { padding: 5rem 0; background: var(--bg-white); }

	.intro-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: start;
	}

	.section-title-left {
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		font-weight: 800;
		color: var(--primary-color);
		margin: 0 0 1.5rem;
		letter-spacing: -0.02em;
		line-height: 1.3;
	}

	.intro-text {
		margin-bottom: 2rem;
	}

	.intro-text p {
		color: var(--text-color);
		line-height: 1.8;
		margin: 0 0 1rem;
		font-size: 1.0625rem;
	}

	.intro-text p:last-child { margin-bottom: 0; }

	.intro-text strong { color: var(--primary-color); }

	.intro-highlights {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
	}

	.highlight {
		padding: 1.5rem;
		background: var(--bg-light);
		border-radius: var(--radius-md);
		border: 1px solid var(--border-color);
		text-align: center;
		transition: all var(--transition-base);
	}

	.highlight:hover {
		border-color: var(--accent-color);
		box-shadow: var(--shadow-md);
	}

	.highlight-number {
		display: block;
		font-size: 2.5rem;
		font-weight: 800;
		color: var(--accent-color);
		line-height: 1;
		margin-bottom: 0.25rem;
	}

	.highlight-label {
		font-size: 0.875rem;
		color: var(--text-muted);
		font-weight: 500;
	}

	.intro-image .image-wrapper {
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-xl);
	}

	.intro-image img {
		width: 100%;
		height: 100%;
		min-height: 400px;
		object-fit: cover;
		display: block;
	}

	/* Mission & Values */
	.mission-values { background: var(--bg-light); padding: 5rem 0; }

	.section-header { text-align: center; margin-bottom: 3.5rem; }

	.section-title {
		font-size: clamp(2rem, 3.5vw, 2.5rem);
		font-weight: 800;
		color: var(--primary-color);
		margin: 0 0 0.75rem;
		letter-spacing: -0.02em;
	}

	.section-subtitle {
		font-size: 1.125rem;
		color: var(--text-muted);
		margin: 0 auto 1.5rem;
		max-width: 600px;
		line-height: 1.6;
	}

	.values-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
	}

	.value-card {
		background: var(--bg-white);
		border: 1px solid var(--border-color);
		border-radius: var(--radius-lg);
		padding: 2rem;
		transition: all var(--transition-base);
		text-align: center;
	}

	.value-card:hover {
		border-color: var(--accent-color);
		box-shadow: var(--shadow-lg);
		transform: translateY(-4px);
	}

	.value-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 64px;
		height: 64px;
		background: linear-gradient(135deg, var(--primary-light), var(--primary-color));
		border-radius: var(--radius-md);
		color: var(--bg-white);
		margin-bottom: 1.25rem;
		transition: background var(--transition-base);
	}

	.value-card:hover .value-icon { background: linear-gradient(135deg, var(--accent-color), var(--accent-dark)); }

	.value-title {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--primary-color);
		margin: 0 0 0.75rem;
	}

	.value-description {
		color: var(--text-muted);
		line-height: 1.6;
		margin: 0;
		font-size: 0.9375rem;
	}

	/* Key Stats */
	.key-stats {
		background: var(--primary-color);
		padding: 4rem 0;
		position: relative;
		overflow: hidden;
	}

	.key-stats::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse 60% 60% at 80% 20%, rgba(226, 135, 67, 0.15) 0%, transparent 60%);
		pointer-events: none;
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2rem;
		position: relative;
		z-index: 1;
	}

	.stat-card {
		display: flex;
		align-items: center;
		gap: 1rem;
		background: rgba(255,255,255,0.05);
		border: 1px solid rgba(255,255,255,0.1);
		border-radius: var(--radius-lg);
		padding: 2rem 1.5rem;
		text-align: left;
		transition: all var(--transition-base);
	}

	.stat-card:hover {
		background: rgba(255,255,255,0.08);
		border-color: rgba(226, 135, 67, 0.3);
	}

	.stat-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		background: rgba(226, 135, 67, 0.2);
		border-radius: var(--radius-md);
		color: var(--accent-color);
		flex-shrink: 0;
	}

	.stat-content { flex: 1; }

	.stat-number {
		font-size: 2.5rem;
		font-weight: 800;
		color: var(--bg-white);
		line-height: 1;
		margin-bottom: 0.25rem;
		letter-spacing: -0.02em;
	}

	.stat-label {
		font-size: 0.9375rem;
		color: rgba(255,255,255,0.7);
		font-weight: 500;
	}

	/* Team & Approach */
	.team-approach { padding: 5rem 0; background: var(--bg-white); }

	.approach-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: start;
	}

	.approach-text p {
		color: var(--text-color);
		line-height: 1.8;
		margin: 0 0 1rem;
		font-size: 1.0625rem;
	}

	.approach-text p:last-child { margin-bottom: 1.5rem; }

	.approach-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.approach-list li {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 0.75rem 0;
		color: var(--text-color);
		font-size: 1rem;
		border-bottom: 1px solid var(--border-light);
	}

	.approach-list li:last-child { border-bottom: none; }

	.approach-list svg {
		color: var(--accent-color);
		flex-shrink: 0;
		margin-top: 0.125rem;
	}

	.approach-image .image-wrapper {
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-xl);
	}

	.approach-image img {
		width: 100%;
		height: 100%;
		min-height: 400px;
		object-fit: cover;
		display: block;
	}

	/* Certifications */
	.certifications { background: var(--bg-light); padding: 5rem 0; }

	.cert-grid {
