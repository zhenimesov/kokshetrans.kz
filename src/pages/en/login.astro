---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin Login — Kokshe Trans Logistics" lang="en">
    <div class="login-page">
        <div class="container">
            <div class="login-card">
                <h1>System Login</h1>
                <p>Publications and news management panel</p>

                <form class="login-form" id="loginForm">
                    <div class="form-group">
                        <label for="username">Login</label>
                        <input type="text" id="username" required placeholder="Enter your login">
                    </div>
                    <div class="form-group">
                        <label for="password">Password</label>
                        <input type="password" id="password" required placeholder="Enter your password">
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">Log in</button>
                    <div id="errorMsg" class="error-msg" style="display: none;">Invalid login or password</div>
                </form>

                <div id="adminPanel" class="admin-panel" style="display: none;">
                    <div class="success-banner">You have successfully logged in as administrator!</div>
                    <h2>Add a new publication</h2>
                    <form id="postForm" class="post-form">
                        <div class="form-group">
                            <label for="postTitle">Publication Title</label>
                            <input type="text" id="postTitle" required placeholder="For example: Opening of a new branch">
                        </div>
                        <div class="form-group">
                            <label for="postContent">Publication Text</label>
                            <textarea id="postContent" rows="6" required placeholder="Enter news or article text..."></textarea>
                        </div>
                        <input type="hidden" id="editIndex" value="-1">
                        <button type="submit" class="btn btn-primary btn-block" id="submitPostBtn">Publish</button>
                    </form>
                    <div id="successPost" class="success-msg" style="display: none;">Publication successfully added!</div>
                    <div id="errorPost" class="error-msg" style="display: none;">An error occurred while saving the publication.</div>

                    <h2 style="margin-top: 3rem;">All publications</h2>
                    <div id="publicationsList" class="publications-list"></div>
                    <button id="logoutBtn" class="btn btn-outline-dark btn-block" style="margin-top: 1rem;">Log out</button>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script>
    const loginForm = document.getElementById('loginForm');
    const adminPanel = document.getElementById('adminPanel');
    const errorMsg = document.getElementById('errorMsg');
    const postForm = document.getElementById('postForm');
    const successPost = document.getElementById('successPost');
    const logoutBtn = document.getElementById('logoutBtn');

    if (localStorage.getItem('isAdmin') === 'true') {
        if (loginForm) loginForm.style.display = 'none';
        if (adminPanel) adminPanel.style.display = 'block';
    }

    if (loginForm) {
        loginForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const user = document.getElementById('username').value;
            const pass = document.getElementById('password').value;

            const DEMO_PASS = import.meta.env.DEMO_PASS || 'demo123';

            if (user === 'admin' && pass === DEMO_PASS) {
                localStorage.setItem('isAdmin', 'true');
                loginForm.style.display = 'none';
                if (adminPanel) adminPanel.style.display = 'block';
                errorMsg.style.display = 'none';
            } else {
                errorMsg.style.display = 'block';
            }
        });
    }

    let editIndex = -1;

    function renderPublications() {
        const list = document.getElementById('publicationsList');
        if (!list) return;
        const posts = JSON.parse(localStorage.getItem('newsPosts') || '[]');
        if (posts.length === 0) {
            list.innerHTML = '<p class="empty-posts">No publications yet.</p>';
            return;
        }
        let html = '<div class="posts-list">';
        posts.forEach((post, index) => {
            html += `
                <div class="post-item">
                    <div class="post-content">
                        <strong>${escapeHtml(post.title)}</strong>
                        <div class="post-meta">${escapeHtml(post.date)}</div>
                        <div class="post-text">${escapeHtml(post.content)}</div>
                    </div>
                    <div class="post-actions">
                        <button type="button" class="btn btn-primary btn-sm edit-btn" data-index="${index}">Edit</button>
                        <button type="button" class="btn btn-outline-dark btn-sm delete-btn" data-index="${index}">Delete</button>
                    </div>
                </div>
            `;
        });
        html += '</div>';
        list.innerHTML = html;

        list.querySelectorAll('.edit-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const idx = parseInt(e.target.dataset.index);
                const posts = JSON.parse(localStorage.getItem('newsPosts') || '[]');
                const post = posts[idx];
                document.getElementById('postTitle').value = post.title;
                document.getElementById('postContent').value = post.content;
                document.getElementById('editIndex').value = idx;
                document.getElementById('submitPostBtn').textContent = 'Update publication';
                document.getElementById('submitPostBtn').classList.add('btn-update');
                editIndex = idx;
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        });

        list.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const idx = parseInt(e.target.dataset.index);
                if (!confirm('Delete this publication?')) return;
                const posts = JSON.parse(localStorage.getItem('newsPosts') || '[]');
                posts.splice(idx, 1);
                localStorage.setItem('newsPosts', JSON.stringify(posts));
                renderPublications();
            });
        });
    }

    if (postForm) {
        postForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const title = document.getElementById('postTitle').value;
            const content = document.getElementById('postContent').value;
            const idx = parseInt(document.getElementById('editIndex').value || '-1');

            const posts = JSON.parse(localStorage.getItem('newsPosts') || '[]');
            if (idx >= 0 && idx < posts.length) {
                posts[idx] = { title, content, date: new Date().toLocaleDateString() };
            } else {
                posts.unshift({ title, content, date: new Date().toLocaleDateString() });
            }
            localStorage.setItem('newsPosts', JSON.stringify(posts));

            successPost.style.display = 'block';
            errorPost.style.display = 'none';
            postForm.reset();
            document.getElementById('editIndex').value = '-1';
            document.getElementById('submitPostBtn').textContent = 'Publish';
            document.getElementById('submitPostBtn').classList.remove('btn-update');
            editIndex = -1;
            renderPublications();
            setTimeout(() => {
                successPost.style.display = 'none';
            }, 3000);
        });
    }

    if (logoutBtn) {
        logoutBtn.addEventListener('click', () => {
            localStorage.removeItem('isAdmin');
            if (adminPanel) adminPanel.style.display = 'none';
            if (loginForm) loginForm.style.display = 'block';
        });
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Initial render if admin panel is visible
    if (adminPanel && adminPanel.style.display !== 'none') {
        renderPublications();
    }
</script>

<style>
    .login-page {
        padding: 5rem 0;
        background-color: var(--bg-light);
        min-height: 70vh;
        display: flex;
        align-items: center;
    }

    .login-card {
        max-width: 500px;
        margin: 0 auto;
        background: white;
        padding: 3rem;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .login-card h1 {
        color: var(--primary-color);
        margin-top: 0;
        font-size: 2rem;
        text-align: center;
    }

    .login-card > p {
        text-align: center;
        color: #666;
        margin-bottom: 2rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        color: var(--primary-color);
        font-weight: 500;
    }

    .form-group input,
    .form-group textarea {
        width: 100%;
        padding: 0.875rem;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-size: 1rem;
    }

    .btn-block {
        width: 100%;
        padding: 0.875rem;
        border: none;
        border-radius: 4px;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
    }

    .btn-primary {
        background-color: var(--accent-color);
        color: white;
    }

    .btn-primary:hover {
        background-color: #d17534;
    }

    .btn-outline-dark {
        background: transparent;
        border: 1px solid var(--primary-color);
        color: var(--primary-color);
    }

    .btn-outline-dark:hover {
        background: var(--primary-color);
        color: white;
    }

    .error-msg {
        color: #d9534f;
        margin-top: 1rem;
        text-align: center;
        font-size: 0.9rem;
    }

    .success-msg {
        color: #5cb85c;
        margin-top: 1rem;
        text-align: center;
        font-weight: 500;
    }

    .success-banner {
        background: #e8f5e9;
        color: #2e7d32;
        padding: 1rem;
        border-radius: 4px;
        text-align: center;
        margin-bottom: 1.5rem;
        font-weight: 500;
    }

    .admin-panel h2 {
        color: var(--primary-color);
        font-size: 1.5rem;
        margin-top: 0;
        margin-bottom: 1rem;
    }
</style>