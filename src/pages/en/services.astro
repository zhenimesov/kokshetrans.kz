---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Services — Kokshe Trans Logistics" lang="en">
	<!-- Page Header -->
	<header class="page-header" aria-labelledby="page-title">
		<div class="container">
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<ol>
					<li><a href="/kokshetrans.kz/en">Home</a></li>
					<li aria-current="page">Services</li>
				</ol>
			</nav>
			<h1 id="page-title" class="page-title">Our Services</h1>
			<p class="page-subtitle">Comprehensive transport and logistics solutions for your business — from route planning to final cargo delivery to the consignee</p>
		</div>
	</header>

	<!-- Services Grid -->
	<section class="services-list" aria-labelledby="services-title">
		<div class="container">
			<div class="services-grid">
				<article class="service-card" id="rail">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 15h18M3 9h18M5 3v18M19 3v18"/><line x1="3" y1="3" x2="21" y2="21"/></svg>
					</div>
					<h2 class="service-title">Rail Freight</h2>
					<p class="service-description">Organization of cargo transportation by rail across the Republic of Kazakhstan, CIS countries and transit. Provision of wagons and containers, forwarding and cargo tracking en route.</p>
					<ul class="service-features">
						<li>Transportation in boxcars, gondola cars and on platforms</li>
						<li>Container transportation (20- and 40-foot containers)</li>
						<li>Development and approval of loading schemes</li>
						<li>Organization of transit transportation across borders</li>
						<li>Cargo forwarding and documentation support</li>
						<li>Real-time cargo location tracking</li>
					</ul>
					<a href="/kokshetrans.kz/en/contacts" class="service-link">Calculate cost <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>

				<article class="service-card" id="truck">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 17h2c.6 0 1-.4 1-1v-3.28c0-.51-.32-.95-.78-1.07l-6.1-.61a2.5 2.5 0 0 1-1.64-.9L8.6 8.6a2.5 2.5 0 0 1-.9-1.64L3 3.78C2.88 3.32 2.44 3 2 3H2v2h0"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
					</div>
					<h2 class="service-title">Road Freight</h2>
					<p class="service-description">Flexible and prompt road transport of general and LTL cargo "door-to-door". Our fleet includes modern vehicles of various capacities.</p>
					<ul class="service-features">
						<li>International and domestic road transport</li>
						<li>LTL (Less than Truck Load) and FTL (Full Truck Load) delivery</li>
						<li>Oversized and heavy cargo transportation</li>
						<li>Curtain-sided, refrigerated, and flatbed trucks</li>
						<li>Express delivery across Kazakhstan</li>
						<li>Cargo insurance for the entire route</li>
					</ul>
					<a href="/kokshetrans.kz/en/contacts" class="service-link">Calculate cost <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>

				<article class="service-card" id="container">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="18" rx="2"/><path d="M10 3v18M14 3v18"/></svg>
					</div>
					<h2 class="service-title">Container Transportation</h2>
					<p class="service-description">Transportation of goods in 20- and 40-foot containers by rail and road, including international destinations.</p>
					<ul class="service-features">
						<li>Container trains on China — Kazakhstan — Europe routes</li>
						<li>Dispatch of single containers and group consignments</li>
						<li>Cargo location control throughout the entire route</li>
						<li>Standard (DC), High Cube (HC), Open Top (OT) containers</li>
						<li>Refrigerated containers for temperature-sensitive cargo</li>
						<li>Multimodal schemes: sea + rail + road</li>
					</ul>
					<a href="/kokshetrans.kz/en/contacts" class="service-link">Calculate cost <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>

				<article class="service-card" id="customs">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12l2 2 4-4"/><path d="M21 12V7H5V5H2v14h3v-2h14v2h3v-7z"/></svg>
					</div>
					<h2 class="service-title">Customs Clearance</h2>
					<p class="service-description">Full range of services for foreign economic activity (FEA) support and customs clearance of goods.</p>
					<ul class="service-features">
						<li>Preparation and verification of shipping documents</li>
						<li>Cargo declaration (DT, transit)</li>
						<li>Calculation and payment of customs duties and taxes</li>
						<li>Obtaining certificates, licenses, examinations</li>
						<li>Representation of client interests in customs</li>
						<li>Consulting on FEA and customs law matters</li>
					</ul>
					<a href="/kokshetrans.kz/en/contacts" class="service-link">Calculate cost <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>

				<article class="service-card" id="warehouse">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 13V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v7"/><path d="M3 13h18"/><path d="M5 13v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V13"/></svg>
					</div>
					<h2 class="service-title">Warehouse Services</h2>
					<p class="service-description">Provision of full range of terminal and warehouse services at stations and ports. Responsible storage, order fulfillment, repacking.</p>
					<ul class="service-features">
						<li>Responsible storage (Class A/B)</li>
						<li>Order fulfillment and assembly</li>
						<li>Cross-docking and transshipment</li>
						<li>Labeling, repacking, strapping</li>
						<li>WMS accounting and inventory</li>
						<li>Distribution logistics (Last Mile)</li>
					</ul>
					<a href="/kokshetrans.kz/en/contacts" class="service-link">Calculate cost <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>

				<article class="service-card" id="insurance">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
					</div>
					<h2 class="service-title">Cargo Insurance</h2>
					<p class="service-description">Comprehensive cargo insurance for the entire route. Working with leading insurance companies, fast claims settlement.</p>
					<ul class="service-features">
						<li>"All Risks" and "Named Perils" policies</li>
						<li>International and domestic insurance</li>
						<li>Policy issuance in 15 minutes</li>
						<li>24/7 support for insurance claims</li>
						<li>Carrier liability insurance</li>
						<li>Individual terms for regular clients</li>
					</ul>
					<a href="/kokshetrans.kz/en/contacts" class="service-link">Calculate cost <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>
			</div>
		</div>
	</section>

	<!-- Additional Services -->
	<section class="additional-services" aria-labelledby="additional-title">
		<div class="container">
			<header class="section-header">
				<h2 id="additional-title" class="section-title">Additional Services</h2>
				<p class="section-subtitle">Specialized services for specific needs of your business</p>
			</header>

			<div class="services-grid">
				<article class="service-card" id="rolling-stock">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8" cy="16" r="2"/><circle cx="16" cy="16" r="2"/></svg>
					</div>
					<h2 class="service-title">Various Rolling Stock</h2>
					<p class="service-description">Provision of various types of rolling stock for transportation of cargo of any complexity according to your tasks.</p>
					<ul class="service-features">
						<li>Grain wagons, gondola cars, container carriers</li>
						<li>Road transport of various capacities (1.5 to 20 tons)</li>
						<li>Special equipment for oversized cargo</li>
						<li>Optimal fleet selection for your cargo</li>
					</ul>
					<a href="/kokshetrans.kz/en/contacts" class="service-link">Learn more <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>

				<article class="service-card" id="terminal">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 13V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v7"/><path d="M3 13h18"/><path d="M5 13v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V13"/></svg>
					</div>
					<h2 class="service-title">Terminal Services</h2>
					<p class="service-description">Provision of full range of terminal services at stations and ports. Prompt cargo handling.</p>
					<ul class="service-features">
						<li>Cargo acceptance and release</li>
						<li>Processing and storage at terminals</li>
						<li>Operational interaction with terminal warehouses</li>
						<li>Weighing, inspection, photo documentation</li>
					</ul>
					<a href="/kokshetrans.kz/en/contacts" class="service-link">Learn more <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>

				<article class="service-card" id="local">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 2v20M2 12h20"/></svg>
					</div>
					<h2 class="service-title">Local Transport (Kokshetau, Baiserke)</h2>
					<p class="service-description">Local cargo transportation within Kokshetau, Baiserke settlement and surrounding areas.</p>
					<ul class="service-features">
						<li>Door-to-door cargo delivery</li>
						<li>Prompt vehicle dispatch</li>
						<li>Transportation of small and large batches</li>
						<li>Capacity up to 20 tons</li>
					</ul>
					<a href="/kokshetrans.kz/en/contacts" class="service-link">Learn more <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>

				<article class="service-card" id="international">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
					</div>
					<h2 class="service-title">International Routes</h2>
					<p class="service-description">Organization of transportation on routes: China — RF/Europe/Uzbekistan, Kazakhstan — China/Russia/Turkey/Afghanistan and others.</p>
					<ul class="service-features">
						<li>Rail and road transport from China and to China</li>
						<li>Container evacuation to China and Turkey</li>
						<li>Routing through CIS and near abroad countries</li>
						<li>Multimodal schemes through ports</li>
					</ul>
					<a href="/kokshetrans.kz/en/contacts" class="service-link">Learn more <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>

				<article class="service-card" id="container-ops">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
					</div>
					<h2 class="service-title">Container Pickup & Delivery</h2>
					<p class="service-description">Prompt container pickup and delivery at stations and terminals with full documentation support.</p>
					<ul class="service-features">
						<li>Documentation for pickup/delivery</li>
						<li>Container condition control (OS/DR)</li>
						<li>Support at all operation stages</li>
						<li>Interaction with lines and terminals</li>
					</ul>
					<a href="/kokshetrans.kz/en/contacts" class="service-link">Learn more <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="cta-section" aria-labelledby="cta-title">
		<div class="container">
			<div class="cta-content">
				<h2 id="cta-title" class="cta-title">Didn't find the service you need?</h2>
				<p class="cta-description">We will select an individual logistics solution for your tasks. Submit a request — a personal manager will contact you within 15 minutes.</p>
				<a href="/kokshetrans.kz/en/contacts" class="btn btn-primary btn-lg">Get Consultation</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* Page Header */
	.page-header {
		background: var(--primary-color);
		color: var(--bg-white);
		padding: 4rem 0;
		position: relative;
		overflow: hidden;
	}

	.page-header::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 60% 50% at 50% 0%, rgba(226, 135, 67, 0.15) 0%, transparent 70%),
			url('https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
		opacity: 0.1;
	}

	.breadcrumb {
		margin-bottom: 1.5rem;
	}

	.breadcrumb ol {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 0;
		font-size: 0.9375rem;
		flex-wrap: wrap;
	}

	.breadcrumb a {
		color: rgba(255,255,255,0.7);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.breadcrumb a:hover { color: var(--accent-color); }

	.breadcrumb li::after {
		content: '/';
		color: rgba(255,255,255,0.4);
		margin-left: 0.5rem;
	}

	.breadcrumb li:last-child::after { display: none; }

	.breadcrumb li[aria-current="page"] {
		color: var(--bg-white);
		font-weight: 500;
	}

	.page-title {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 800;
		margin: 0 0 1rem;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.page-subtitle {
		font-size: 1.125rem;
		color: rgba(255,255,255,0.8);
		margin: 0;
		max-width: 700px;
		line-height: 1.7;
	}

	/* Services List */
	.services-list { padding: 5rem 0; background: var(--bg-white); }

	.services-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
		gap: 1.5rem;
	}

	.service-card {
		background: var(--bg-white);
		border: 1px solid var(--border-color);
		border-radius: var(--radius-lg);
		padding: 2.5rem 2rem;
		transition: all var(--transition-base);
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.service-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 4px;
		background: linear-gradient(90deg, var(--primary-color), var(--accent-color));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--transition-base);
	}

	.service-card:hover {
		border-color: var(--accent-color);
		box-shadow: var(--shadow-xl);
		transform: translateY(-4px);
	}

	.service-card:hover::before { transform: scaleX(1); }

	.service-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		background: linear-gradient(135deg, var(--primary-light), var(--primary-color));
		border-radius: var(--radius-md);
		color: var(--bg-white);
		margin-bottom: 1.25rem;
		transition: background var(--transition-base);
		flex-shrink: 0;
	}

	.service-card:hover .service-icon { background: linear-gradient(135deg, var(--accent-color), var(--accent-dark)); }

	.service-title {
		font-size: 1.375rem;
		font-weight: 700;
		color: var(--primary-color);
		margin: 0 0 0.75rem;
		letter-spacing: -0.01em;
	}

	.service-description {
		color: var(--text-muted);
		line-height: 1.7;
		margin: 0 0 1.25rem;
		font-size: 0.9375rem;
		flex: 1;
	}

	.service-features {
		list-style: none;
		padding: 0;
		margin: 0 0 1.5rem;
	}

	.service-features li {
		position: relative;
		padding-left: 1.5rem;
		margin-bottom: 0.5rem;
		font-size: 0.875rem;
		color: var(--text-color);
		line-height: 1.5;
	}

	.service-features li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55rem;
		width: 6px;
		height: 6px;
		background: var(--accent-color);
		border-radius: 50%;
	}

	.service-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--primary-color);
		font-weight: 600;
		text-decoration: none;
		font-size: 0.9375rem;
		transition: color var(--transition-fast), gap var(--transition-fast);
		margin-top: auto;
		padding-top: 1rem;
		border-top: 1px solid var(--border-light);
	}

	.service-link:hover { color: var(--accent-color); gap: 0.75rem; }

	/* Additional Services */
	.additional-services { background: var(--bg-light); padding: 5rem 0; }

	.section-header {
		text-align: center;
		margin-bottom: 3.5rem;
	}

	.section-title {
		font-size: clamp(2rem, 3.5vw, 2.5rem);
		font-weight: 800;
		color: var(--primary-color);
		margin: 0 0 0.75rem;
		letter-spacing: -0.02em;
	}

	.section-subtitle {
		font-size: 1.125rem;
		color: var(--text-muted);
		margin: 0 auto 1.5rem;
		max-width: 600px;
		line-height: 1.6;
	}

	/* CTA Section */
	.cta-section {
		background: var(--primary-color);
		padding: 4rem 0;
		position: relative;
		overflow: hidden;
	}

	.cta-section::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse 60% 60% at 80% 20%, rgba(226, 135, 67, 0.15) 0%, transparent 60%);
		pointer-events: none;
	}

	.cta-content {
		position: relative;
		z-index: 1;
		text-align: center;
		max-width: 700px;
		margin: 0 auto;
	}

	.cta-title {
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		font-weight: 800;
		color: var(--bg-white);
		margin: 0 0 1rem;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.cta-description {
		font-size: 1.125rem;
		color: rgba(255,255,255,0.8);
		line-height: 1.7;
		margin: 0 0 2rem;
	}

	/* Mobile */
	@media (max-width: 768px) {
		.page-header { padding: 3rem 0; }
		.services-list, .additional-services { padding: 3.5rem 0; }
		.services-grid { grid-template-columns: 1fr; gap: 1rem; }
		.service-card { padding: 1.5rem; }
		.cta-section { padding: 3rem 0; }
	}

	@media (max-width: 480px) {
		.page-title { font-size: 1.75rem; }
		.service-card { padding: 1.25rem; }
		.service-icon { width: 48px; height: 48px; }
		.breadcrumb { font-size: 0.875rem; }
	}
</style>