---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Services — Kokshe Trans Logistics" lang="en">
    <div class="page-header">
        <div class="container">
            <h1>Our Services</h1>
            <p>Comprehensive transport and logistics solutions for your business</p>
        </div>
    </div>

    <section class="services-content">
        <div class="container">
            <div class="service-item">
                <h2>Rail Freight</h2>
                <p>Organizing freight transportation by rail across Kazakhstan, CIS countries and transit routes. Providing wagons and containers, expeditioning and tracking shipments.</p>
                <ul>
                    <li>Transport in covered wagons, flatcars and platforms</li>
                    <li>Container transport (20- and 40-foot containers)</li>
                    <li>Development and coordination of loading schemes</li>
                </ul>
            </div>

            <div class="service-item">
                <h2>Road Transport</h2>
                <p>Flexible and efficient road transport of general and consolidated cargo "door to door". We have a modern fleet of various capacities.</p>
                <ul>
                    <li>International and domestic transport</li>
                    <li>Delivery of consolidated (LTL) and full (FTL) truckloads</li>
                    <li>Transport of oversized and heavy cargo</li>
                </ul>
            </div>

            <div class="service-item">
                <h2>Container Transport</h2>
                <p>Transport of cargo in 20- and 40-foot containers by rail and road, including international routes.</p>
                <ul>
                    <li>Container trains</li>
                    <li>Single container shipments</li>
                    <li>Real-time tracking of cargo location</li>
                </ul>
            </div>
        </div>
    </section>
</Layout>

<style>
    .page-header {
        background-color: var(--primary-color);
        color: white;
        padding: 4rem 0;
        text-align: center;
    }

    .page-header h1 {
        margin: 0 0 1rem 0;
        font-size: 2.5rem;
    }

    .page-header p {
        margin: 0;
        opacity: 0.8;
        font-size: 1.1rem;
    }

    .services-content {
        padding: 4rem 0;
    }

    .service-item {
        background: var(--bg-light);
        padding: 3rem;
        border-radius: 8px;
        margin-bottom: 2.5rem;
        border-left: 5px solid var(--accent-color);
    }

    .service-item h2 {
        color: var(--primary-color);
        margin-top: 0;
        margin-bottom: 1.5rem;
        font-size: 1.75rem;
        text-align: center;
    }

    .service-item p {
        color: #555;
        line-height: 1.7;
        font-size: 1.1rem;
    }

    .service-item ul {
        margin-top: 1.5rem;
        padding-left: 1.2rem;
        color: #444;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .service-item li {
        margin-bottom: 0.75rem;
        line-height: 1.6;
    }
</style>