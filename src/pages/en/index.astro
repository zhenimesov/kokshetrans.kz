---
import Layout from '../../layouts/Layout.astro';
import Publications from '../../components/Publications.astro';
---

<Layout title="Kokshe Trans Logistics — Reliable Logistics & Freight Transportation in Kazakhstan" lang="en">
	<!-- Hero Section -->
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero-bg" aria-hidden="true"></div>
		<div class="container hero-content">
			<div class="hero-badge">
				<span class="badge-dot" aria-hidden="true"></span>
				<span>Kokshe Trans Logistics LLP — Licensed Railway Carrier</span>
			</div>
			<h1 id="hero-title" class="hero-title">Reliable Logistics for Your Business</h1>
			<p class="hero-description">Comprehensive transport and logistics solutions: railway and road freight, container shipping, customs clearance, and warehousing services across Kazakhstan, CIS, and international routes.</p>
			<div class="hero-actions">
				<a href="/kokshetrans.kz/en/contacts" class="btn btn-primary btn-lg">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
					Get a Quote
				</a>
				<a href="/kokshetrans.kz/en/services" class="btn btn-outline btn-lg">
					Our Services
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
				</a>
			</div>

			<div class="hero-stats" aria-label="Key Company Metrics">
				<div class="stat-item">
					<span class="stat-value" data-count="10">10+</span>
					<span class="stat-label">Years of Experience</span>
				</div>
				<div class="stat-divider" aria-hidden="true"></div>
				<div class="stat-item">
					<span class="stat-value" data-count="5000">5000+</span>
					<span class="stat-label">Delivered Shipments</span>
				</div>
				<div class="stat-divider" aria-hidden="true"></div>
				<div class="stat-item">
					<span class="stat-value" data-count="15">15+</span>
					<span class="stat-label">Destination Countries</span>
				</div>
				<div class="stat-divider" aria-hidden="true"></div>
				<div class="stat-item">
					<span class="stat-value" data-count="100">100%</span>
					<span class="stat-label">Cargo Insurance</span>
				</div>
			</div>
		</div>

		<div class="hero-scroll" aria-hidden="true">
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
		</div>
	</section>

	<!-- Services Section -->
	<section class="services" id="services" aria-labelledby="services-title">
		<div class="container">
			<header class="section-header">
				<h2 id="services-title" class="section-title">Our Services</h2>
				<p class="section-subtitle">Full-cycle logistics services — from route planning to final delivery to the consignee</p>
				<a href="/kokshetrans.kz/en/services" class="section-link">All Services <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
			</header>

			<div class="services-grid">
				<article class="service-card" id="rail">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 15h18M3 9h18M5 3v18M19 3v18"/><line x1="3" y1="3" x2="21" y2="21"/></svg>
					</div>
					<h3 class="service-title">Rail Freight</h3>
					<p class="service-description">Cargo transportation by rolling stock and containers at optimal rates. Full support: from application to cargo release at destination station.</p>
					<ul class="service-features">
						<li>Wagon shipments (covered, half-wagons, flatcars)</li>
						<li>Container shipping 20/40 ft</li>
						<li>Dangerous goods transport</li>
						<li>Real-time cargo tracking</li>
					</ul>
					<a href="/kokshetrans.kz/en/services#rail" class="service-link">Learn More <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>

				<article class="service-card" id="truck">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 17h2c.6 0 1-.4 1-1v-3.28c0-.51-.32-.95-.78-1.07l-6.1-.61a2.5 2.5 0 0 1-1.64-.9L8.6 8.6a2.5 2.5 0 0 1-.9-1.64L3 3.78C2.88 3.32 2.44 3 2 3H2v2h0"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
					</div>
					<h3 class="service-title">Road Freight</h3>
					<p class="service-description">LTL and FTL cargo delivery by road transport. Own fleet and verified partners for any route.</p>
					<ul class="service-features">
						<li>LTL (consolidated) and FTL (full truckload)</li>
						<li>Curtain-side, refrigerated, flatbed trucks</li>
						<li>Door-to-door delivery</li>
						<li>Express delivery across Kazakhstan</li>
					</ul>
					<a href="/kokshetrans.kz/en/services#truck" class="service-link">Learn More <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>

				<article class="service-card" id="container">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="18" rx="2"/><path d="M10 3v18M14 3v18"/></svg>
					</div>
					<h3 class="service-title">Container Shipping</h3>
					<p class="service-description">20-ft and 40-ft container shipping across Kazakhstan, China, Russia, Turkey, Uzbekistan and other countries. Multimodal delivery schemes.</p>
					<ul class="service-features">
						<li>Standard (DC), High Cube (HC), Open Top (OT) containers</li>
						<li>Refrigerated containers</li>
						<li>Sea + rail + road (multimodal)</li>
						<li>Domestic shipping within RK</li>
					</ul>
					<a href="/kokshetrans.kz/en/services#container" class="service-link">Learn More <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>

				<article class="service-card" id="customs">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12l2 2 4-4"/><path d="M21 12V7H5V5H2v14h3v-2h14v2h3v-7z"/></svg>
					</div>
					<h3 class="service-title">Customs Clearance</h3>
					<p class="service-description">Full customs support: document preparation, duty calculation, customs control processing, obtaining permits.</p>
					<ul class="service-features">
						<li>Customs declarations (DT, transit)</li>
						<li>Duty and tax calculation & payment</li>
						<li>Certificates, licenses, expert opinions</li>
						<li>Customs broker representation</li>
					</ul>
					<a href="/kokshetrans.kz/en/services#customs" class="service-link">Learn More <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>

				<article class="service-card" id="warehouse">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 13V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v7"/><path d="M3 13h18"/><path d="M5 13v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V13"/></svg>
					</div>
					<h3 class="service-title">Warehousing Services</h3>
					<p class="service-description">Responsible storage, order fulfillment, repacking, labeling, and distribution logistics at own terminals.</p>
					<ul class="service-features">
						<li>Responsible storage (Class A/B)</li>
						<li>Order picking & assembly</li>
						<li>Cross-docking & transshipment</li>
						<li>WMS inventory & stocktaking</li>
					</ul>
					<a href="/kokshetrans.kz/en/services#warehouse" class="service-link">Learn More <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>

				<article class="service-card" id="insurance">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
					</div>
					<h3 class="service-title">Cargo Insurance</h3>
					<p class="service-description">Full cargo insurance throughout the entire route. Working with leading insurers, fast claims settlement.</p>
					<ul class="service-features">
						<li>"All Risks" and "Named Perils" policies</li>
						<li>International & domestic insurance</li>
						<li>Policy issuance in 15 minutes</li>
						<li>24/7 claims support</li>
					</ul>
					<a href="/kokshetrans.kz/en/services#insurance" class="service-link">Learn More <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>
			</div>
		</div>
	</section>

	<!-- Advantages Section -->
	<section class="advantages" aria-labelledby="advantages-title">
		<div class="container">
			<header class="section-header">
				<h2 id="advantages-title" class="section-title">Why Choose Us</h2>
				<p class="section-subtitle">We don't just transport cargo — we build long-term logistics partnerships</p>
			</header>

			<div class="advantages-grid">
				<div class="advantage-card">
					<div class="advantage-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
					</div>
					<h3>Reliability & Safety</h3>
					<p>100% insurance on every shipment, real-time GPS tracking, own fleet and verified partners. Your cargo is safe at every kilometer.</p>
				</div>

				<div class="advantage-card">
					<div class="advantage-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2v20"/></svg>
					</div>
					<h3>Wide Geography</h3>
					<p>Routes across Kazakhstan, CIS, China, Europe, Turkey, Iran and Asia. Multimodal schemes: rail + road + sea for optimal cost and transit times.</p>
				</div>

				<div class="advantage-card">
					<div class="advantage-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
					</div>
					<h3>Personal Manager</h3>
					<p>Each client gets a dedicated logistics expert who knows your business, monitors every shipment 24/7, and resolves any issues without bureaucracy. One contact — all solutions.</p>
				</div>

				<div class="advantage-card">
					<div class="advantage-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
					</div>
					<h3>Transparent Pricing</h3>
					<p>Clear rates with no hidden fees. Cost calculation in 30 minutes. Single contract, single invoice, full reporting in client portal. You pay only for results.</p>
				</div>

				<div class="advantage-card">
					<div class="advantage-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
					</div>
					<h3>Digital Client Portal</h3>
					<p>Real-time cargo tracking, shipment history, documents, acts, invoices — all in one place. 24/7 access from any device. API for ERP integration.</p>
				</div>

				<div class="advantage-card">
					<div class="advantage-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
					</div>
					<h3>Documentation Support</h3>
					<p>Complete preparation of accompanying documents: CIM/SMGS, CMR, waybills, quality certificates, veterinary/phytosanitary certificates. Minimum involvement from you.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="cta" aria-labelledby="cta-title">
		<div class="container">
			<div class="cta-content">
				<div class="cta-text">
					<h2 id="cta-title" class="cta-title">Ready to Start Cooperation?</h2>
					<p class="cta-description">Get a cost and transit time calculation within 30 minutes. Your personal manager will contact you within 15 minutes after submitting the request.</p>
					<ul class="cta-benefits">
						<li>Free cost calculation</li>
						<li>Logistics expert consultation</li>
						<li>Individual terms for regular clients</li>
					</ul>
				</div>
				<div class="cta-form-wrapper">
					<form class="cta-form" action="/kokshetrans.kz/en/contacts" method="GET">
						<div class="form-row">
							<div class="form-group">
								<label for="cta-name">Your Name <span aria-hidden="true">*</span></label>
								<input type="text" id="cta-name" name="name" required placeholder="John Doe" autocomplete="name">
							</div>
							<div class="form-group">
								<label for="cta-phone">Phone <span aria-hidden="true">*</span></label>
								<input type="tel" id="cta-phone" name="phone" required placeholder="+7 (___) ___-__-__" autocomplete="tel">
							</div>
						</div>
						<div class="form-group">
							<label for="cta-cargo">What are you shipping?</label>
							<select id="cta-cargo" name="cargo">
								<option value="">Select cargo type</option>
								<option value="general">General Cargo (FTL)</option>
								<option value="ltt">Consolidated Cargo (LTL)</option>
								<option value="container">Container</option>
								<option value="dangerous">Dangerous Goods</option>
								<option value="oversized">Oversized Cargo</option>
								<option value="other">Other</option>
							</select>
						</div>
						<button type="submit" class="btn btn-primary btn-lg btn-block">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
							Get Calculation
						</button>
						<p class="form-note">By clicking the button, you agree to <a href="#">personal data processing</a></p>
					</form>
				</div>
			</div>
		</div>
	</section>

	<!-- Publications Section -->
	<Publications lang="en" />
</Layout>

<style>
	/* Hero Section */
	.hero {
		position: relative;
		background: var(--primary-color);
		color: var(--bg-white);
		padding: 6rem 0 4rem;
		overflow: hidden;
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 80% 50% at 50% 0%, rgba(226, 135, 67, 0.15) 0%, transparent 70%),
			url('https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
		opacity: 0.12;
	}

	.hero-bg::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(11, 37, 69, 0.9) 0%, rgba(11, 37, 69, 1) 100%);
	}

	.hero-content {
		position: relative;
		z-index: 1;
		max-width: 800px;
	}

	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: rgba(255,255,255,0.08);
		border: 1px solid rgba(255,255,255,0.15);
		border-radius: 100px;
		padding: 0.5rem 1rem 0.5rem 0.75rem;
		font-size: 0.8125rem;
		font-weight: 500;
		color: rgba(255,255,255,0.9);
		margin-bottom: 1.5rem;
		backdrop-filter: blur(10px);
	}

	.badge-dot {
		width: 8px;
		height: 8px;
		background: var(--accent-color);
		border-radius: 50%;
		animation: pulse 2s infinite;
		flex-shrink: 0;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.6; transform: scale(1.1); }
	}

	.hero-title {
		font-size: clamp(2.5rem, 5vw, 3.75rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.02em;
		margin: 0 0 1.5rem;
		color: var(--bg-white);
	}

	.hero-description {
		font-size: clamp(1.125rem, 2vw, 1.25rem);
		line-height: 1.7;
		color: rgba(255,255,255,0.8);
		margin: 0 0 2rem;
		max-width: 650px;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 3rem;
	}

	.hero-stats {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
		padding-top: 2rem;
		border-top: 1px solid rgba(255,255,255,0.1);
	}

	.stat-item {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 100px;
	}

	.stat-value {
		font-size: clamp(2rem, 3vw, 2.5rem);
		font-weight: 800;
		color: var(--accent-color);
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.stat-label {
		font-size: 0.8125rem;
		color: rgba(255,255,255,0.6);
		font-weight: 500;
	}

	.stat-divider {
		width: 1px;
		height: 50px;
		background: linear-gradient(180deg, transparent, rgba(255,255,255,0.2), transparent);
	}

	.hero-scroll {
		position: absolute;
		bottom: 2rem;
		left: 50%;
		transform: translateX(-50%);
		color: rgba(255,255,255,0.5);
		animation: bounce 2s infinite;
		cursor: pointer;
		transition: color var(--transition-base);
	}

	.hero-scroll:hover { color: var(--accent-color); }

	@keyframes bounce {
		0%, 20%, 50%, 80%, 100% { transform: translateX(-50%) translateY(0); }
		40% { transform: translateX(-50%) translateY(-8px); }
		60% { transform: translateX(-50%) translateY(-4px); }
	}

	/* Section Common */
	section { padding: 5rem 0; }

	.section-header {
		text-align: center;
		margin-bottom: 3.5rem;
	}

	.section-title {
		font-size: clamp(2rem, 3.5vw, 2.5rem);
		font-weight: 800;
		color: var(--primary-color);
		margin: 0 0 0.75rem;
		letter-spacing: -0.02em;
	}

	.section-subtitle {
		font-size: 1.125rem;
		color: var(--text-muted);
		margin: 0 auto 1.5rem;
		max-width: 600px;
		line-height: 1.6;
	}

	.section-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--accent-color);
		font-weight: 600;
		text-decoration: none;
		font-size: 0.9375rem;
		transition: gap var(--transition-fast), color var(--transition-fast);
	}

	.section-link:hover { gap: 0.75rem; color: var(--accent-dark); }

	/* Services Grid */
	.services { background: var(--bg-white); }

	.services-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
		gap: 1.5rem;
	}

	.service-card {
		background: var(--bg-white);
		border: 1px solid var(--border-color);
		border-radius: var(--radius-lg);
		padding: 2.5rem 2rem;
		transition: all var(--transition-base);
		position: relative;
		overflow: hidden;
	}

	.service-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 4px;
		background: linear-gradient(90deg, var(--primary-color), var(--accent-color));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--transition-base);
	}

	.service-card:hover {
		border-color: var(--accent-color);
		box-shadow: var(--shadow-xl);
		transform: translateY(-4px);
	}

	.service-card:hover::before { transform: scaleX(1); }

	.service-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		background: linear-gradient(135deg, var(--primary-light), var(--primary-color));
		border-radius: var(--radius-md);
		color: var(--bg-white);
		margin-bottom: 1.25rem;
		transition: background var(--transition-base);
	}

	.service-card:hover .service-icon { background: linear-gradient(135deg, var(--accent-color), var(--accent-dark)); }

	.service-title {
		font-size: 1.375rem;
		font-weight: 700;
		color: var(--primary-color);
		margin: 0 0 0.75rem;
		letter-spacing: -0.01em;
	}

	.service-description {
