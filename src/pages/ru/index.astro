</style>

<script>
	// Animate counter numbers on scroll
	const statValues = document.querySelectorAll('.stat-value[data-count]');

	const animateCounter = (el) => {
		const target = parseInt(el.dataset.count);
		const suffix = el.textContent.includes('+') ? '+' : (el.textContent.includes('%') ? '%' : '');
		const duration = 2000;
		const start = performance.now();

		const update = (now) => {
			const progress = Math.min((now - start) / duration, 1);
			const eased = 1 - Math.pow(1 - progress, 3);
			const current = Math.floor(target * eased);
			el.textContent = current + suffix;
			if (progress < 1) requestAnimationFrame(update);
		};

		requestAnimationFrame(update);
	};

	const observer = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				animateCounter(entry.target);
				observer.unobserve(entry.target);
			}
		});
	}, { threshold: 0.5 });

	statValues.forEach(el => observer.observe(el));

	// Phone input mask for CTA form
	const ctaPhoneInput = document.getElementById('cta-phone');
	if (ctaPhoneInput) {
		ctaPhoneInput.addEventListener('input', (e) => {
			let value = e.target.value.replace(/\D/g, '');
			if (value.length > 0 && value[0] !== '7') value = '7' + value;
			if (value.length > 11) value = value.slice(0, 11);

			let formatted = '';
			if (value.length > 0) {
				formatted = '+7';
				if (value.length > 1) formatted += ' (' + value.substring(1, 4);
				if (value.length >= 5) formatted += ') ' + value.substring(4, 7);
				if (value.length >= 8) formatted += '-' + value.substring(7, 9);
				if (value.length >= 10) formatted += '-' + value.substring(9, 11);
			}
			e.target.value = formatted;
		});
		ctaPhoneInput.addEventListener('focus', () => {
			if (!ctaPhoneInput.value) ctaPhoneInput.value = '+7 (7';
		});
	}

	// CTA Form Submission
	const ctaForm = document.getElementById('ctaForm');
	const ctaSubmitBtn = document.getElementById('ctaSubmitBtn');
	const ctaStatus = document.getElementById('ctaStatus');

	if (ctaForm && ctaSubmitBtn) {
		ctaForm.addEventListener('submit', async (e) => {
			e.preventDefault();

			const name = document.getElementById('cta-name');
			const phone = document.getElementById('cta-phone');
			const cargo = document.getElementById('cta-cargo');

			if (!name.value || !phone.value || phone.value.length < 18) {
				name.style.borderColor = !name.value ? 'rgba(244, 67, 54, 0.5)' : '';
				phone.style.borderColor = (!phone.value || phone.value.length < 18) ? 'rgba(244, 67, 54, 0.5)' : '';
				return;
			}

			ctaSubmitBtn.disabled = true;
			const btnText = ctaSubmitBtn.querySelector('.btn-text');
			const btnLoading = ctaSubmitBtn.querySelector('.btn-loading');
			btnText.style.display = 'none';
			btnLoading.style.display = 'inline-block';
			ctaStatus.style.display = 'none';

			try {
				const botToken = import.meta.env.PUBLIC_TELEGRAM_BOT_TOKEN;
				const chatId = '-5335737211';

				if (!botToken) throw new Error('Missing token');

				const message = `📋 <b>Запрос расчета с сайта</b>\n\n👤 <b>Имя:</b> ${name.value}\n📞 <b>Телефон:</b> ${phone.value}\n📦 <b>Груз:</b> ${cargo.value || 'не указан'}`;

				const res = await fetch(`https://api.telegram.org/bot${botToken}/sendMessage`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ chat_id: chatId, text: message, parse_mode: 'HTML' })
				});

				if (res.ok) {
					ctaStatus.textContent = 'Заявка отправлена! Мы свяжемся с вами.';
					ctaStatus.className = 'form-status success';
					ctaStatus.style.display = 'block';
					ctaForm.reset();
				} else {
					throw new Error('API error');
				}
			} catch (err) {
				ctaStatus.textContent = 'Ошибка отправки. Попробуйте еще раз.';
				ctaStatus.className = 'form-status error';
				ctaStatus.style.display = 'block';
			} finally {
				ctaSubmitBtn.disabled = false;
				btnText.style.display = 'inline-block';
				btnLoading.style.display = 'none';
			}
		});
	}
</script>
