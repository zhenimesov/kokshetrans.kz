---
import Layout from '../../layouts/Layout.astro';
import Publications from '../../components/Publications.astro';
---

<Layout title="Кокше Транс Логистик — Надежная логистика и грузоперевозки в Казахстане" lang="ru">
	<!-- Hero Section -->
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero-bg" aria-hidden="true"></div>
		<div class="container hero-content">
			<div class="hero-badge">
				<span class="badge-dot" aria-hidden="true"></span>
				<span>ТОО «Кокше Транс Логистик» — лицензиат Ж/Д перевозок</span>
			</div>
			<h1 id="hero-title" class="hero-title">Надежная логистика для вашего бизнеса</h1>
			<p class="hero-description">Комплексные транспортно-логистические решения: ж/д и автоперевозки, контейнерные перевозки, таможенное оформление и складские услуги по Казахстану, СНГ и международным маршрутам.</p>
			<div class="hero-actions">
				<a href="/kokshetrans.kz/ru/contacts" class="btn btn-primary btn-lg">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
					Оставить заявку
				</a>
				<a href="/kokshetrans.kz/ru/services" class="btn btn-outline btn-lg">
					Наши услуги
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
				</a>
			</div>

			<div class="hero-stats" aria-label="Ключевые показатели компании">
				<div class="stat-item">
					<span class="stat-value" data-count="10">10+</span>
					<span class="stat-label">Лет опыта</span>
				</div>
				<div class="stat-divider" aria-hidden="true"></div>
				<div class="stat-item">
					<span class="stat-value" data-count="5000">5000+</span>
					<span class="stat-label">Доставленных грузов</span>
				</div>
				<div class="stat-divider" aria-hidden="true"></div>
				<div class="stat-item">
					<span class="stat-value" data-count="15">15+</span>
					<span class="stat-label">Страх назначения</span>
				</div>
				<div class="stat-divider" aria-hidden="true"></div>
				<div class="stat-item">
					<span class="stat-value" data-count="100">100%</span>
					<span class="stat-label">Страхование груза</span>
				</div>
			</div>
		</div>

		<div class="hero-scroll" aria-hidden="true">
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
		</div>
	</section>

	<!-- Services Section -->
	<section class="services" id="services" aria-labelledby="services-title">
		<div class="container">
			<header class="section-header">
				<h2 id="services-title" class="section-title">Наши услуги</h2>
				<p class="section-subtitle">Полный цикл логистических услуг под ключ — от планирования маршрута до вручения груза получателю</p>
				<a href="/kokshetrans.kz/ru/services" class="section-link">Все услуги <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
			</header>

			<div class="services-grid">
				<article class="service-card" id="rail">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 15h18M3 9h18M5 3v18M19 3v18"/><line x1="3" y1="3" x2="21" y2="21"/></svg>
					</div>
					<h3 class="service-title">Ж/Д перевозки</h3>
					<p class="service-description">Перевозка грузов вагонным парком и контейнерами по оптимальным тарифам. Полная поддержка: от оформления заявки до выдачи груза на станции назначения.</p>
					<ul class="service-features">
						<li>Вагонные перевозки (критые, полувагоны, платформы)</li>
						<li>Контейнерные перевозки 20/40 фут</li>
						<li>Перевозка опасных грузов</li>
						<li>Мониторинг груза в реальном времени</li>
					</ul>
					<a href="/kokshetrans.kz/ru/services#rail" class="service-link">Подробнее <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>

				<article class="service-card" id="truck">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 17h2c.6 0 1-.4 1-1v-3.28c0-.51-.32-.95-.78-1.07l-6.1-.61a2.5 2.5 0 0 1-1.64-.9L8.6 8.6a2.5 2.5 0 0 1-.9-1.64L3 3.78C2.88 3.32 2.44 3 2 3H2v2h0"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
					</div>
					<h3 class="service-title">Автоперевозки</h3>
					<p class="service-description">Доставка сборных и генеральных грузов автомобильным транспортом. Собственный автопарк и проверенные партнеры для любых маршрутов.</p>
					<ul class="service-features">
						<li>Сборные грузы (LTL) и генеральные (FTL)</li>
						<li>Тентовые, рефрижераторные, бортовые авто</li>
						<li>Доставка «от двери до двери»</li>
						<li>Экспресс-доставка по Казахстану</li>
					</ul>
					<a href="/kokshetrans.kz/ru/services#truck" class="service-link">Подробнее <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>

				<article class="service-card" id="container">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="18" rx="2"/><path d="M10 3v18M14 3v18"/></svg>
					</div>
					<h3 class="service-title">Контейнерные перевозки</h3>
					<p class="service-description">Отправка 20- и 40-футовых контейнеров по Казахстану, в Китай, Россию, Турцию, Узбекистан и другие страны. Мультимодальные схемы доставки.</p>
					<ul class="service-features">
						<li>Стандартные (DC), высокие (HC), открытые (OT) контейнеры</li>
						<li>Рефрижераторные контейнеры</li>
						<li>Морские + ж/д + авто (мультимодал)</li>
						<li>Внутренние перевозки по РК</li>
					</ul>
					<a href="/kokshetrans.kz/ru/services#container" class="service-link">Подробнее <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>

				<article class="service-card" id="customs">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12l2 2 4-4"/><path d="M21 12V7H5V5H2v14h3v-2h14v2h3v-7z"/></svg>
					</div>
					<h3 class="service-title">Таможенное оформление</h3>
					<p class="service-description">Полное таможенное сопровождение: подготовка документов, расчет платежей, прохождение таможенного контроля, получение разрешительных документов.</p>
					<ul class="service-features">
						<li>Таможенные декларации (ДТ, транзит)</li>
						<li>Расчет и уплата таможенных платежей</li>
						<li>Получение сертификатов, лицензий, заключений</li>
						<li>Таможенный представитель (брокер)</li>
					</ul>
					<a href="/kokshetrans.kz/ru/services#customs" class="service-link">Подробнее <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>

				<article class="service-card" id="warehouse">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 13V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v7"/><path d="M3 13h18"/><path d="M5 13v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V13"/></svg>
					</div>
					<h3 class="service-title">Складские услуги</h3>
					<p class="service-description">Ответственное хранение, комплектация заказов, переупаковка, маркировка и распределительная логистика на собственных терминалах.</p>
					<ul class="service-features">
						<li>Ответственное хранение (класс А/В)</li>
						<li>Комплектация и сборка заказов</li>
						<li>Кросс-докинг и перевалка</li>
						<li>WMS-учет и инвентаризация</li>
					</ul>
					<a href="/kokshetrans.kz/ru/services#warehouse" class="service-link">Подробнее <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>

				<article class="service-card" id="insurance">
					<div class="service-icon" aria-hidden="true">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
					</div>
					<h3 class="service-title">Страхование грузов</h3>
					<p class="service-description">Полное страхование грузов на всем маршруте следования. Работа с ведущими страховыми компаниями, быстрое урегулирование убытков.</p>
					<ul class="service-features">
						<li>Полисы «Все риски» и «От именованных рисков»</li>
						<li>Международное и внутреннее страхование</li>
						<li>Оформление за 15 минут</li>
						<li>Поддержка при страховых случаях 24/7</li>
					</ul>
					<a href="/kokshetrans.kz/ru/services#insurance" class="service-link">Подробнее <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
				</article>
			</div>
		</div>
	</section>

	<!-- Advantages Section -->
	<section class="advantages" aria-labelledby="advantages-title">
		<div class="container">
			<header class="section-header">
				<h2 id="advantages-title" class="section-title">Почему выбирают нас</h2>
				<p class="section-subtitle">Мы не просто перевозим грузы — мы строим долгосрочные логистические партнерства</p>
			</header>

			<div class="advantages-grid">
				<div class="advantage-card">
					<div class="advantage-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
					</div>
					<h3>Надежность и безопасность</h3>
					<p>100% страхование каждого груза, GPS-мониторинг в реальном времени, собственный автопарк и проверенные партнеры. Ваш груз в безопасности на каждом километре пути.</p>
				</div>

				<div class="advantage-card">
					<div class="advantage-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2v20"/></svg>
					</div>
					<h3>Широкая география</h3>
					<p>Маршруты по всему Казахстану, странам СНГ, Китаю, Европе, Турции, Ирану и Азии. Мультимодальные схемы: ж/д + авто + море для оптимальной стоимости и сроков.</p>
				</div>

				<div class="advantage-card">
					<div class="advantage-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
					</div>
					<h3>Персональный менеджер</h3>
					<p>Каждому клиенту — свой логист, который знает ваш бизнес, контролирует каждую отправку 24/7 и решает любые вопросы без бюрократии. Один контакт — все решения.</p>
				</div>

				<div class="advantage-card">
					<div class="advantage-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
					</div>
					<h3>Прозрачное ценообразование</h3>
					<p>Четкие тарифы без скрытых доплат. Расчет стоимости за 30 минут. Единый договор, единый счет, полная отчетность в личном кабинете. Вы платите только за результат.</p>
				</div>

				<div class="advantage-card">
					<div class="advantage-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
					</div>
					<h3>Цифровой личный кабинет</h3>
					<p>Отслеживание грузов в реальном времени, история отправок, документы, акты, счета — всё в одном месте. Доступ 24/7 с любого устройства. API для интеграции с вашей ERP.</p>
				</div>

				<div class="advantage-card">
					<div class="advantage-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
					</div>
					<h3>Документальная поддержка</h3>
					<p>Полное оформление сопроводительных документов: ТН, СМГС, CMR, накладные, сертификаты качества, ветеринарные/фитосанитарные свидетельства. Минимум вашего участия.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="cta" aria-labelledby="cta-title">
		<div class="container">
			<div class="cta-content">
				<div class="cta-text">
					<h2 id="cta-title" class="cta-title">Готовы начать сотрудничество?</h2>
					<p class="cta-description">Получите расчет стоимости и сроков доставки за 30 минут. Ваш персональный менеджер свяжется с вами в течение 15 минут после отправки заявки.</p>
					<ul class="cta-benefits">
						<li>Расчет стоимости бесплатно</li>
						<li>Консультация эксперта по логистике</li>
						<li>Индивидуальные условия для постоянных клиентов</li>
					</ul>
				</div>
				<div class="cta-form-wrapper">
					<form class="cta-form" action="/kokshetrans.kz/ru/contacts" method="GET">
						<div class="form-row">
							<div class="form-group">
								<label for="cta-name">Ваше имя <span aria-hidden="true">*</span></label>
								<input type="text" id="cta-name" name="name" required placeholder="Иван Иванов" autocomplete="name">
							</div>
							<div class="form-group">
								<label for="cta-phone">Телефон <span aria-hidden="true">*</span></label>
								<input type="tel" id="cta-phone" name="phone" required placeholder="+7 (___) ___-__-__" autocomplete="tel">
							</div>
						</div>
						<div class="form-group">
							<label for="cta-cargo">Что перевозите?</label>
							<select id="cta-cargo" name="cargo">
								<option value="">Выберите тип груза</option>
								<option value="general">Генеральный груз</option>
								<option value="ltt">Сборный груз (LTL)</option>
								<option value="container">Контейнер</option>
								<option value="dangerous">Опасный груз</option>
								<option value="oversized">Негабаритный груз</option>
								<option value="other">Другое</option>
							</select>
						</div>
						<button type="submit" class="btn btn-primary btn-lg btn-block">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
							Получить расчет
						</button>
						<p class="form-note">Нажимая кнопку, вы соглашаетесь с <a href="#">обработкой персональных данных</a></p>
					</form>
				</div>
			</div>
		</div>
	</section>

	<!-- Publications Section -->
	<Publications lang="ru" />
</Layout>

<style>
	/* Hero Section */
	.hero {
		position: relative;
		background: var(--primary-color);
		color: var(--bg-white);
		padding: 6rem 0 4rem;
		overflow: hidden;
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 80% 50% at 50% 0%, rgba(226, 135, 67, 0.15) 0%, transparent 70%),
			url('https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
		opacity: 0.12;
	}

	.hero-bg::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(11, 37, 69, 0.9) 0%, rgba(11, 37, 69, 1) 100%);
	}

	.hero-content {
		position: relative;
		z-index: 1;
		max-width: 800px;
	}

	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: rgba(255,255,255,0.08);
		border: 1px solid rgba(255,255,255,0.15);
		border-radius: 100px;
		padding: 0.5rem 1rem 0.5rem 0.75rem;
		font-size: 0.8125rem;
		font-weight: 500;
		color: rgba(255,255,255,0.9);
		margin-bottom: 1.5rem;
		backdrop-filter: blur(10px);
	}

	.badge-dot {
		width: 8px;
		height: 8px;
		background: var(--accent-color);
		border-radius: 50%;
		animation: pulse 2s infinite;
		flex-shrink: 0;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.6; transform: scale(1.1); }
	}

	.hero-title {
		font-size: clamp(2.5rem, 5vw, 3.75rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.02em;
		margin: 0 0 1.5rem;
		color: var(--bg-white);
	}

	.hero-description {
		font-size: clamp(1.125rem, 2vw, 1.25rem);
		line-height: 1.7;
		color: rgba(255,255,255,0.8);
		margin: 0 0 2rem;
		max-width: 650px;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 3rem;
	}

	.hero-stats {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
		padding-top: 2rem;
		border-top: 1px solid rgba(255,255,255,0.1);
	}

	.stat-item {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 100px;
	}

	.stat-value {
		font-size: clamp(2rem, 3vw, 2.5rem);
		font-weight: 800;
		color: var(--accent-color);
		line-height: 1;
		letter-spacing: -0.02em;
	}

