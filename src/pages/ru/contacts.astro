---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<Layout title="Контакты — Кокше Транс Логистик" lang="ru">
    <div class="page-header">
        <div class="container">
            <h1>Свяжитесь с нами</h1>
            <p>Мы всегда открыты для сотрудничества и готовы ответить на ваши вопросы</p>
        </div>
    </div>

    <section class="contacts-section">
        <div class="container">
            <div class="contacts-grid">
                <div class="contact-info">
                    <h2>Наши контакты</h2>
                    <p class="subtitle">Свяжитесь с нашими специалистами любым удобным способом.</p>

                    <div class="info-item">
                        <h3>Адрес</h3>
                        <p>Республика Казахстан, г. Кокшетау</p>
                    </div>

                    <div class="info-item">
                        <h3>Телефоны</h3>
                        <p><a href="tel:+77162000000">+7 (7162) 00-00-00</a></p>
                        <p><a href="tel:+77010000000">+7 (701) 000-00-00</a></p>
                    </div>

                    <div class="info-item">
                        <h3>Email</h3>
                        <p><a href="mailto:info@kokshetrans.kz">info@kokshetrans.kz</a></p>
                    </div>

                    <div class="info-item">
                        <h3>Режим работы</h3>
                        <p>Пн - Пт: 09:00 – 18:00<br>Сб - Вс: Выходной</p>
                    </div>
                </div>

                <ContactForm lang="ru" />
            </div>
        </div>
    </section>
</Layout>

<style>
    .page-header {
        background-color: var(--primary-color);
        color: white;
        padding: 4rem 0;
        text-align: center;
    }

    .page-header h1 {
        margin: 0 0 1rem 0;
        font-size: 2.5rem;
    }

    .page-header p {
        margin: 0;
        opacity: 0.8;
        font-size: 1.1rem;
    }

    .contacts-section {
        padding: 5rem 0;
    }

    .contacts-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
    }

    .contact-info {
        max-width: 700px;
        margin: 0 auto;
        text-align: center;
    }

    .contact-info h2 {
        color: var(--primary-color);
        font-size: 2rem;
        margin-top: 0;
        margin-bottom: 0.5rem;
        text-align: center;
    }

    .subtitle {
        color: #666;
        margin-bottom: 1.5rem;
        font-size: 1rem;
        line-height: 1.6;
        text-align: center;
    }

    .info-item {
        margin-bottom: 2rem;
        text-align: center;
    }

    .info-item h3 {
        color: var(--secondary-color);
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
        text-align: center;
    }

    .info-item p, .info-item a {
        color: #444;
        margin: 0;
        font-size: 1.05rem;
        text-decoration: none;
        text-align: center;
    }

    .info-item a:hover {
        color: var(--accent-color);
        text-decoration: underline;
    }

    @media (max-width: 768px) {
        .contacts-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }
</style>
