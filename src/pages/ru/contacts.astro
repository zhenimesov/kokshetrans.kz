---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<Layout title="Контакты — Кокше Транс Логистик" lang="ru">
	<!-- Page Header -->
	<header class="page-header" aria-labelledby="page-title">
		<div class="container">
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<ol>
					<li><a href="/kokshetrans.kz/ru">Главная</a></li>
					<li aria-current="page">Контакты</li>
				</ol>
			</nav>
			<h1 id="page-title" class="page-title">Контакты</h1>
			<p class="page-subtitle">Мы всегда на связи. Выберите удобный способ связи — ответим в течение 15 минут в рабочее время</p>
		</div>
	</header>

	<!-- Contact Info Cards -->
	<section class="contact-info" aria-labelledby="info-title">
		<div class="container">
			<div class="info-grid">
				<article class="info-card">
					<div class="info-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
					</div>
					<h3 class="info-title">Адрес офиса</h3>
					<address class="info-content">
						<p>Республика Казахстан</p>
						<p>Акмолинская область, г. Кокшетау</p>
						<p>ул. Абая, 45, офис 302</p>
					</address>
					<a href="https://yandex.kz/maps/10243/kokshetau/?ll=69.381846%2C53.283176&z=16" target="_blank" rel="noopener noreferrer" class="info-link">Открыть на карте <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg></a>
				</article>

				<article class="info-card">
					<div class="info-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
					</div>
					<h3 class="info-title">Телефоны</h3>
					<div class="info-content">
						<p><a href="tel:+77162000000">+7 (7162) 00-00-00</a> — Единый справочный</p>
						<p><a href="tel:+77771234567">+7 (777) 123-45-67</a> — Отдел продаж</p>
						<p><a href="tel:+77071234567">+7 (707) 123-45-67</a> — Диспетчерская (24/7)</p>
					</div>
				</article>

				<article class="info-card">
					<div class="info-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
					</div>
					<h3 class="info-title">Email</h3>
					<div class="info-content">
						<p><a href="mailto:info@kokshetrans.kz">info@kokshetrans.kz</a> — Общие вопросы</p>
						<p><a href="mailto:sales@kokshetrans.kz">sales@kokshetrans.kz</a> — Коммерческие предложения</p>
						<p><a href="mailto:dispatch@kokshetrans.kz">dispatch@kokshetrans.kz</a> — Диспетчерская служба</p>
						<p><a href="mailto:customs@kokshetrans.kz">customs@kokshetrans.kz</a> — Таможенное оформление</p>
					</div>
				</article>

				<article class="info-card">
					<div class="info-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
					</div>
					<h3 class="info-title">Режим работы</h3>
					<div class="info-content">
						<p><strong>Понедельник — Пятница:</strong> 09:00 — 18:00</p>
						<p><strong>Суббота:</strong> 10:00 — 14:00</p>
						<p><strong>Воскресенье:</strong> Выходной</p>
						<p class="info-note">Диспетчерская служба работает круглосуточно</p>
					</div>
				</article>

				<article class="info-card">
					<div class="info-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
					</div>
					<h3 class="info-title">Социальные сети</h3>
					<div class="info-content">
						<div class="social-links">
							<a href="https://t.me/kokshetrans" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Telegram"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm5.171 14.232l-4.803 1.418c-.346.102-.704-.017-1.01-.317l-1.696-1.733-2.739 1.115c-.333.136-.619-.205-.55-.536l.579-2.868-2.049-1.997c-.34-.332-.265-.856.148-1.13l3.432-2.298-1.014-3.632c-.112-.401.288-.744.665-.744h1.635c.227 0 .436.096.59.26l1.407 1.452 2.863-1.123c.346-.136.68.064.905.436l1.879 3.028 3.324-1.584c.396-.189.86.094.93.516l.263 1.499c.053.294-.063.597-.287.816l-3.359 3.17z"/></svg></a>
							<a href="https://www.linkedin.com/company/kokshetrans" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
							<a href="https://wa.me/77771234567" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="WhatsApp"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.52 3.48A11.914 11.914 0 0 0 12 0C5.373 0 .001 5.373.001 12c0 2.184.585 4.224 1.607 5.997L.001 24l6.306-1.654A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12 0-1.958-.48-3.816-1.307-5.475a11.135 11.135 0 0 0-2.173-5.045zm-8.438 11.206c-.274-.017-1.077-.193-1.425-.466-.158-.122-.361-.203-.602.062-.24.263-.635.595-.944.908-.31.314-.66.557-1.034.618-.373.062-.843-.034-1.005-.258-.16-.223-.228-.456-.143-.77.075-.286.206-.62.278-.858.07-.237.023-.475-.132-.648-.142-.157-.495-.427-.71-.608-.174-.143-.306-.19-.447-.19-.14 0-.28.047-.413.077-.24.054-.512.128-.713.254-.31.195-.743.583-.89.768-.136.173-.18.38-.163.533.017.14.137.356.355.665.436.617 1.293 1.584 1.69 2.05.275.32.474.49.602.54.11.042.196.038.287-.033.164-.126.233-.348.178-.533-.07-.235-.227-.59-.33-.708-.12-.13-.33-.12-.48-.12-.133 0-.27.007-.39.023-.255.034-.726.213-1.04.213-.355 0-.713-.096-1.059-.287z"/></svg></a>
						</div>
					</div>
				</article>

				<article class="info-card">
					<div class="info-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
					</div>
					<h3 class="info-title">Реквизиты компании</h3>
					<div class="info-content">
						<p><strong>ТОО «Кокше Транс Логистик»</strong></p>
						<p>БИН: 200840012345</p>
						<p>ИИК: KZ123456789012345678</p>
						<p>Банк: АО «Казкоммерцбанк»</p>
						<p>БИК: KCBCKZKX</p>
					</div>
				</article>
			</div>
		</div>
	</section>

	<!-- Contact Form Section -->
	<section class="contact-form-section" aria-labelledby="form-title">
		<div class="container">
			<div class="form-grid">
				<div class="form-intro">
					<h2 id="form-title" class="section-title-left">Оставьте заявку</h2>
					<p class="form-description">Заполните форму — персональный менеджер свяжется с вами в течение 15 минут для консультации и расчета стоимости перевозки.</p>
					<ul class="form-benefits">
						<li>
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
							Бесплатный расчет стоимости
						</li>
						<li>
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
							Подбор оптимального маршрута
						</li>
						<li>
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
							Консультация по таможне и документам
						</li>
						<li>
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
							Ответ в течение 15 минут
						</li>
					</ul>
				</div>
				<div class="form-wrapper">
					<ContactForm lang="ru" />
				</div>
			</div>
		</div>
	</section>

	<!-- Map Section -->
	<section class="map-section" aria-labelledby="map-title">
		<div class="container">
			<h2 id="map-title" class="section-title" style="text-align: center; margin-bottom: 1.5rem;">Наш офис на карте</h2>
			<div class="map-wrapper">
				<iframe
					src="https://yandex.kz/map-widget/v1/?ll=69.381846%2C53.283176&z=16&mode=search&ol=geo&ouri=ymapsbm1%3A%2F%2Fgeo%3Fll%3D69.381846%252C53.283176%26z%3D16"
					width="100%"
					height="400"
					frameborder="0"
					style="border: 0; border-radius: var(--radius-lg);"
					allowfullscreen
					title="Офис Кокше Транс Логистик на карте"
					loading="lazy"
				></iframe>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* Page Header */
	.page-header {
		background: var(--primary-color);
		color: var(--bg-white);
		padding: 4rem 0;
		position: relative;
		overflow: hidden;
	}

	.page-header::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 60% 50% at 50% 0%, rgba(226, 135, 67, 0.15) 0%, transparent 70%),
			url('https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
		opacity: 0.1;
	}

	.breadcrumb {
		margin-bottom: 1.5rem;
	}

	.breadcrumb ol {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 0;
		font-size: 0.9375rem;
		flex-wrap: wrap;
	}

	.breadcrumb a {
		color: rgba(255,255,255,0.7);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.breadcrumb a:hover { color: var(--accent-color); }

	.breadcrumb li::after {
		content: '/';
		color: rgba(255,255,255,0.4);
		margin-left: 0.5rem;
	}

	.breadcrumb li:last-child::after { display: none; }

	.breadcrumb li[aria-current="page"] {
		color: var(--bg-white);
		font-weight: 500;
	}

	.page-title {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 800;
		margin: 0 0 1rem;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.page-subtitle {
		font-size: 1.125rem;
		color: rgba(255,255,255,0.8);
		margin: 0;
		max-width: 700px;
		line-height: 1.7;
	}

	/* Contact Info */
	.contact-info { padding: 5rem 0; background: var(--bg-white); }

	.info-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 1.5rem;
	}

	.info-card {
		background: var(--bg-white);
		border: 1px solid var(--border-color);
		border-radius: var(--radius-lg);
		padding: 2rem;
		transition: all var(--transition-base);
		display: flex;
		flex-direction: column;
	}

	.info-card:hover {
		border-color: var(--accent-color);
		box-shadow: var(--shadow-lg);
		transform: translateY(-4px);
	}

	.info-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		background: linear-gradient(135deg, var(--primary-light), var(--primary-color));
		border-radius: var(--radius-md);
		color: var(--bg-white);
		margin-bottom: 1.25rem;
		transition: background var(--transition-base);
		flex-shrink: 0;
	}

	.info-card:hover .info-icon { background: linear-gradient(135deg, var(--accent-color), var(--accent-dark)); }

	.info-title {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--primary-color);
		margin: 0 0 1rem;
	}

	.info-content {
		flex: 1;
		color: var(--text-color);
		line-height: 1.7;
		margin: 0;
		font-size: 0.9375rem;
	}

	.info-content p { margin: 0 0 0.5rem; }

	.info-content p:last-child { margin-bottom: 0; }

	.info-content a {
		color: var(--primary-color);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.info-content a:hover { color: var(--accent-color); }

	.info-note {
		font-size: 0.875rem;
		color: var(--text-muted);
		font-style: italic;
		margin-top: 0.75rem !important;
	}

	.info-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border-light);
		color: var(--primary-color);
		font-weight: 600;
		text-decoration: none;
		font-size: 0.9375rem;
		transition: color var(--transition-fast), gap var(--transition-fast);
	}

	.info-link:hover { color: var(--accent-color); gap: 0.75rem; }

	.social-links {
		display: flex;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}

	.social-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		background: var(--bg-light);
		border: 1px solid var(--border-color);
		border-radius: var(--radius-md);
		color: var(--primary-color);
		transition: all var(--transition-fast);
	}

	.social-link:hover {
		background: var(--accent-color);
		border-color: var(--accent-color);
		color: var(--bg-white);
		transform: translateY(-2px);
	}

	/* Contact Form Section */
	.contact-form-section { background: var(--bg-light); padding: 5rem 0; }

	.form-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: start;
	}

	.section-title-left {
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		font-weight: 800;
		color: var(--primary-color);
		margin: 0 0 1rem;
		letter-spacing: -0.02em;
		line-height: 1.3;
	}

	.form-description {
		color: var(--text-muted);
		line-height: 1.7;
		margin: 0 0 2rem;
		font-size: 1.0625rem;
	}

	.form-benefits {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.form-benefits li {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 0.75rem 0;
		color: var(--text-color);
		font-size: 1rem;
		border-bottom: 1px solid var(--border-light);
	}

	.form-benefits li:last-child { border-bottom: none; }

	.form-benefits svg {
		color: var(--accent-color);
		flex-shrink: 0;
		margin-top: 0.125rem;
	}

	.form-wrapper {
		background: var(--bg-white);
		border: 1px solid var(--border-color);
		border-radius: var(--radius-lg);
		padding: 2.5rem;
		box-shadow: var(--shadow-lg);
	}

	/* Map Section */
	.map-section { padding: 5rem 0; background: var(--bg-white); }

	.map-wrapper {
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-xl);
		max-width: 100%;
	}

	/* Mobile */
	@media (max-width: 1024px) {
		.form-grid { grid-template-columns: 1fr; gap: 2rem; }
	}

	@media (max-width: 768px) {
		.page-header { padding: 3rem 0; }
		.contact-info, .contact-form-section, .map-section { padding: 3.5rem 0; }
		.info-grid { grid-template-columns: 1fr; }
		.form-wrapper { padding: 1.5rem; }
		.map-wrapper iframe { height: 300px; }
	}

	@media (max-width: 480) {
		.page-title { font-size: 1.75rem; }
		.breadcrumb { font-size: 0.875rem; }
	}
</style>