---
interface Props {
  lang?: 'ru' | 'en';
}

const { lang = 'ru' } = Astro.props;

const texts = {
  ru: {
    title: 'Оставить заявку',
    subtitle: 'Заполните форму, и мы свяжемся с вами в течение 15 минут.',
    name: 'Ваше имя',
    namePlaceholder: 'Иван Иванов',
    phone: 'Телефон',
    phonePlaceholder: '+7 (___) ___-__-__',
    cargo: 'Детали груза',
    cargoPlaceholder: 'Тип груза, вес, маршрут, сроки...',
    submit: 'Отправить заявку',
    sending: 'Отправка...',
    success: 'Заявка отправлена! Мы свяжемся с вами в ближайшее время.',
    error: 'Ошибка отправки. Попробуйте еще раз или позвоните нам напрямую.',
    required: 'Обязательное поле'
  },
  en: {
    title: 'Request a Quote',
    subtitle: 'Fill out the form and we will contact you within 15 minutes.',
    name: 'Your Name',
    namePlaceholder: 'John Doe',
    phone: 'Phone',
    phonePlaceholder: '+7 (___) ___-__-__',
    cargo: 'Cargo Details',
    cargoPlaceholder: 'Cargo type, weight, route, timeline...',
    submit: 'Submit Request',
    sending: 'Sending...',
    success: 'Request sent! We will contact you shortly.',
    error: 'Failed to send. Please try again or call us directly.',
    required: 'Required field'
  }
};

const t = texts[lang];
---

<div class="contact-form-wrapper">
  <form class="contact-form" id="contactForm" data-lang={lang} novalidate>
    <div class="form-group">
      <label for="name">{t.name} <span class="required" aria-hidden="true">*</span></label>
      <input type="text" id="name" name="name" required placeholder={t.namePlaceholder} aria-required="true" autocomplete="name">
      <span class="error-msg" data-for="name" aria-live="polite">{t.required}</span>
    </div>
    <div class="form-group">
      <label for="phone">{t.phone} <span class="required" aria-hidden="true">*</span></label>
      <input type="tel" id="phone" name="phone" required placeholder={t.phonePlaceholder} aria-required="true" autocomplete="tel" inputmode="tel">
      <span class="error-msg" data-for="phone" aria-live="polite">{t.required}</span>
    </div>
    <div class="form-group">
      <label for="cargo">{t.cargo}</label>
      <textarea id="cargo" name="cargo" rows="4" placeholder={t.cargoPlaceholder}></textarea>
    </div>
    <button type="submit" class="btn btn-primary btn-block" id="submitBtn">
      <span class="btn-text">{t.submit}</span>
      <span class="btn-loading" style="display: none;" aria-hidden="true">{t.sending}</span>
    </button>
    <div id="formStatus" class="form-status" style="display: none;" aria-live="polite"></div>
  </form>
</div>

<script>
  // Phone mask for Kazakh format: +7 (XXX) XXX-XX-XX
  function applyPhoneMask(input) {
    let value = input.value.replace(/\D/g, '');
    if (!value.startsWith('7')) {
      value = '7' + value;
    }
    let formatted = '+7 ';
    if (value.length > 1) {
      formatted += '(' + value.slice(1, 4);
    }
    if (value.length >= 4) {
      formatted += ') ' + value.slice(4, 7);
    }
    if (value.length >= 7) {
      formatted += '-' + value.slice(7, 9);
    }
    if (value.length >= 9) {
      formatted += '-' + value.slice(9, 11);
    }
    input.value = formatted;
  }

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contactForm');
    const submitBtn = document.getElementById('submitBtn');
    const btnText = submitBtn?.querySelector('.btn-text');
    const btnLoading = submitBtn?.querySelector('.btn-loading');
    const statusEl = document.getElementById('formStatus');
    const phoneInput = form?.querySelector('#phone');

    if (!form) return;

    // Phone mask
    if (phoneInput) {
      phoneInput.addEventListener('input', () => applyPhoneMask(phoneInput));
      phoneInput.addEventListener('focus', () => {
        if (!phoneInput.value) phoneInput.value = '+7 (';
      });
      phoneInput.addEventListener('blur', () => {
        if (phoneInput.value === '+7 (') phoneInput.value = '';
      });
    }

    // Получаем переводы для текущего языка
    const lang = form.dataset.lang || 'ru';
    const translations = {
      ru: {
        success: 'Заявка отправлена! Мы свяжемся с вами в ближайшее время.',
        error: 'Ошибка отправки. Попробуйте еще раз или позвоните нам напрямую.',
        required: 'Обязательное поле'
      },
      en: {
        success: 'Request sent! We will contact you shortly.',
        error: 'Failed to send. Please try again or call us directly.',
        required: 'Required field'
      }
    };
    const t = translations[lang];

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Валидация
      const name = form.querySelector('#name');
      const phone = form.querySelector('#phone');
      let valid = true;

      [name, phone].forEach(input => {
        const errorEl = form.querySelector(`[data-for="${input.id}"]`);
        if (input.required && !input.value.trim()) {
          input.classList.add('invalid');
          input.setAttribute('aria-invalid', 'true');
          if (errorEl) errorEl.style.display = 'block';
          valid = false;
        } else {
          input.classList.remove('invalid');
          input.removeAttribute('aria-invalid');
          if (errorEl) errorEl.style.display = 'none';
        }
      });

      if (!valid) return;

      // Собираем данные
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      // UI loading
      submitBtn.disabled = true;
      if (btnText) btnText.style.display = 'none';
      if (btnLoading) btnLoading.style.display = 'inline';
      if (statusEl) {
        statusEl.style.display = 'none';
        statusEl.className = 'form-status';
      }

      try {
        // PUBLIC_-переменные Astro подставляет в клиентский бандл при сборке.
        // Значение приходит из GitHub Secrets (TELEGRAM_API) через workflow.
        const botToken = import.meta.env.PUBLIC_TELEGRAM_BOT_TOKEN;
        const chatId = '-5335737211';

        if (!botToken) {
          throw new Error('Telegram bot token is not configured');
        }

        const escapeHtml = (s) =>
          String(s).replace(/&/g, '&').replace(/</g, '<').replace(/>/g, '>');

        const now = new Date();
        const dateStr = now.toLocaleDateString('ru-RU', {
          day: '2-digit',
          month: 'long',
          year: 'numeric'
        });
        const timeStr = now.toLocaleTimeString('ru-RU', {
          hour: '2-digit',
          minute: '2-digit'
        });

        const message =
          '📋 <b>Новая заявка с сайта — Обращение к нам</b>\n\n' +
          `👤 <b>Имя:</b> ${escapeHtml(data.name)}\n` +
          `📞 <b>Телефон:</b> ${escapeHtml(data.phone)}\n` +
          `📦 <b>Груз:</b> ${escapeHtml(data.cargo || 'не указан')}\n` +
          `🕐 <b>Дата и время:</b> ${dateStr} в ${timeStr}\n\n` +
          '📞 Мы свяжемся с вами в течение 15 минут.';

        const response = await fetch(`https://api.telegram.org/bot${botToken}/sendMessage`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            chat_id: chatId,
            text: message,
            parse_mode: 'HTML'
          })
        });

        const result = await response.json().catch(() => null);

        if (!response.ok || !result?.ok) {
          throw new Error(result?.description || 'Telegram API error');
        }

        if (statusEl) {
          statusEl.textContent = t.success;
          statusEl.className = 'form-status success';
          statusEl.style.display = 'block';
        }
        form.reset();
        if (phoneInput) phoneInput.value = '';
      } catch (err) {
        if (statusEl) {
          statusEl.textContent = t.error;
          statusEl.className = 'form-status error';
          statusEl.style.display = 'block';
        }
      } finally {
        submitBtn.disabled = false;
        if (btnText) btnText.style.display = 'inline';
        if (btnLoading) btnLoading.style.display = 'none';
      }
    });

    // Скрываем ошибки при вводе
    form.querySelectorAll('input, textarea').forEach(input => {
      input.addEventListener('input', () => {
        input.classList.remove('invalid');
        input.removeAttribute('aria-invalid');
        const errorEl = form.querySelector(`[data-for="${input.id}"]`);
        if (errorEl) errorEl.style.display = 'none';
      });
    });
  });
</script>

<style>
  .contact-form-wrapper {
    background: var(--bg-white);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-lg);
    width: 100%;
    max-width: 100%;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    position: relative;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--primary-color);
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .required {
    color: var(--accent-color);
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0.875rem 1rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    font-size: 1rem;
    background: var(--bg-white);
    color: var(--text-color);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), background var(--transition-fast);
    font-family: inherit;
    box-sizing: border-box;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--text-muted);
    opacity: 0.7;
  }

  .form-group input:hover,
  .form-group textarea:hover {
    border-color: var(--primary-light);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--secondary-color);
    box-shadow: 0 0 0 4px rgba(19, 64, 116, 0.1);
    background: var(--bg-white);
  }

  .form-group input.invalid,
  .form-group textarea.invalid {
    border-color: #d9534f;
  }

  .form-group input.invalid:focus,
  .form-group textarea.invalid:focus {
    box-shadow: 0 0 0 4px rgba(217, 83, 79, 0.1);
  }

  .error-msg {
    display: none;
    color: #d9534f;
    font-size: 0.8125rem;
    margin-top: 0.375rem;
  }

  .btn-block {
    width: 100%;
    padding: 1rem 2rem;
    border: none;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    text-align: center;
    transition: background-color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--accent-color), var(--accent-dark));
    color: var(--bg-white);
    box-shadow: var(--shadow-md);
  }

  .btn-primary:hover:not(:disabled) {
    background: linear-gradient(135deg, var(--accent-dark), var(--accent-color));
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .btn-primary:active:not(:disabled) {
    transform: translateY(0);
    box-shadow: var(--shadow-sm);
  }

  .btn-primary:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  .btn-loading {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-loading::before {
    content: '';
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: var(--bg-white);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .form-status {
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    margin-top: 0.5rem;
    text-align: center;
    font-weight: 500;
    font-size: 0.9375rem;
    animation: slideIn 0.3s ease;
  }

  .form-status.success {
    background: #e8f5e9;
    color: #2e7d32;
    border: 1px solid #a5d6a7;
  }

  .form-status.error {
    background: #fdeaea;
    color: #c62828;
    border: 1px solid #ef9a9a;
  }

  @keyframes slideIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .contact-form-wrapper {
      padding: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .contact-form-wrapper {
      padding: 1.25rem;
    }
    .form-group input,
    .form-group textarea {
      padding: 0.75rem 0.875rem;
    }
    .btn-block {
      padding: 0.875rem 1.5rem;
    }
  }
</style>