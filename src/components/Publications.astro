---
interface Props {
  lang?: 'ru' | 'en';
}

const { lang = 'ru' } = Astro.props;

const texts = {
  ru: {
    title: 'Последние публикации',
    empty: 'Публикаций пока нет.',
    viewAll: 'Все новости'
  },
  en: {
    title: 'Latest News',
    empty: 'No publications yet.',
    viewAll: 'All news'
  }
};

const t = texts[lang];
---

<section class="publications" id="publications">
  <div class="container">
    <div class="publications-header">
      <h2 class="section-title">{t.title}</h2>
      <a href={`/kokshetrans.kz/${lang}/news`} class="btn btn-outline">{t.viewAll} →</a>
    </div>

    <div id="publicationsContent" class="publications-track" data-lang={lang}></div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('publicationsContent');
    if (!track) return;

    const lang = track.dataset.lang || 'ru';
    const t = {
      ru: { empty: 'Публикаций пока нет.' },
      en: { empty: 'No publications yet.' }
    }[lang];

    const posts = JSON.parse(localStorage.getItem('newsPosts') || '[]');

    if (posts.length === 0) {
      track.innerHTML = `<p class="empty-posts">${t.empty}</p>`;
      return;
    }

    // Show only the 3 latest posts for the front page
    const latestPosts = posts.slice(0, 3);

    function escapeHtml(text) {
      if (!text) return '';
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function formatDate(dateStr) {
      if (!dateStr) return '';
      try {
        const d = new Date(dateStr);
        if (isNaN(d.getTime())) return dateStr;
        return d.toLocaleDateString(lang === 'ru' ? 'ru-RU' : 'en-US', {
          day: 'numeric',
          month: 'long',
          year: 'numeric'
        });
      } catch (e) {
        return dateStr;
      }
    }

    track.innerHTML = latestPosts.map((post) => {
      const imageHtml = post.image
        ? `<div class="publication-image"><img src="${escapeHtml(post.image)}" alt="" loading="lazy"></div>`
        : `<div class="publication-image-placeholder">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
           </div>`;

      return `
        <a href="#" class="publication-card">
          ${imageHtml}
          <div class="publication-card-content">
            <h3 class="publication-title">${escapeHtml(post.title)}</h3>
            <div class="publication-meta">
              <span class="publication-date">${formatDate(post.date)}</span>
              <span class="publication-views">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                ${post.views || 0}
              </span>
            </div>
          </div>
        </a>
      `;
    }).join('');
  });
</script>

<style>
  .publications {
    background-color: var(--bg-white);
    padding: 6rem 0;
  }

  .publications-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3rem;
  }

  .section-title {
    margin: 0;
    font-size: 2.25rem;
    color: var(--primary-color);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .publications-track {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .publication-card {
    background: white;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: all var(--transition-base);
    border: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .publication-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-xl);
    border-color: var(--accent-color);
  }

  .publication-image {
    height: 220px;
    overflow: hidden;
    background: var(--bg-light);
  }

  .publication-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .publication-card:hover .publication-image img {
    transform: scale(1.08);
  }

  .publication-image-placeholder {
    height: 220px;
    background: var(--bg-light);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-light);
  }

  .publication-card-content {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .publication-date {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .publication-title {
    color: var(--text-color);
    font-size: 1.125rem;
    margin: 0.5rem 0;
    font-weight: 600;
    line-height: 1.3;
    flex-grow: 1;
  }

  .publication-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .publication-views {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  @media (max-width: 992px) {
    .publications-track { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .publications-track { grid-template-columns: 1fr; }
    .publications-header { flex-direction: column; gap: 1.5rem; text-align: center; }
  }
</style>
