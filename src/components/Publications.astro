---
interface Props {
  lang?: 'ru' | 'en';
}

const { lang = 'ru' } = Astro.props;

const texts = {
  ru: {
    title: 'Наши публикации',
    empty: 'Публикаций пока нет.',
    next: 'Следующая публикация',
    prev: 'Предыдущая публикация',
    viewAll: 'Смотреть все'
  },
  en: {
    title: 'Our Publications',
    empty: 'No publications yet.',
    next: 'Next publication',
    prev: 'Previous publication',
    viewAll: 'View all'
  }
};

const t = texts[lang];
---

<section class="publications" id="publications">
  <div class="container">
    <div class="publications-header">
      <h2 class="section-title">{t.title}</h2>
      <div class="publications-nav">
        <button type="button" class="btn btn-outline nav-btn nav-prev" id="pubPrev" disabled>
          ← {t.prev}
        </button>
        <button type="button" class="btn btn-outline nav-btn nav-next" id="pubNext">
          {t.next} →
        </button>
      </div>
    </div>

    <div class="publications-carousel">
      <div id="publicationsContent" class="publications-track" data-lang={lang}></div>
    </div>

    <div class="publications-dots" id="publicationsDots"></div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('publicationsContent');
    const dotsContainer = document.getElementById('publicationsDots');
    const prevBtn = document.getElementById('pubPrev');
    const nextBtn = document.getElementById('pubNext');
    if (!track) return;

    const lang = track.dataset.lang || 'ru';
    const t = {
      ru: { empty: 'Публикаций пока нет.' },
      en: { empty: 'No publications yet.' }
    }[lang];

    const posts = JSON.parse(localStorage.getItem('newsPosts') || '[]');

    if (posts.length === 0) {
      track.innerHTML = `<p class="empty-posts">${t.empty}</p>`;
      if (prevBtn) prevBtn.style.display = 'none';
      if (nextBtn) nextBtn.style.display = 'none';
      return;
    }

    let currentIndex = 0;

    function escapeHtml(text) {
      if (!text) return '';
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function render() {
      // Show one featured card + preview of next
      const visible = posts.slice(currentIndex, currentIndex + 3);
      track.innerHTML = visible.map((post, i) => {
        const isActive = i === 0;
        const imageHtml = post.image
          ? `<div class="publication-image"><img src="${escapeHtml(post.image)}" alt="${escapeHtml(post.title)}" loading="lazy"></div>`
          : `<div class="publication-image-placeholder"><span>📷</span></div>`;

        return `
          <div class="publication-card ${isActive ? 'active' : ''}">
            ${imageHtml}
            <div class="publication-date">${post.date}</div>
            <h3 class="publication-title">${escapeHtml(post.title)}</h3>
            <p class="publication-excerpt">${escapeHtml(post.content)}</p>
          </div>
        `;
      }).join('');

      // Update dots
      if (dotsContainer) {
        const total = Math.ceil(posts.length / 3);
        dotsContainer.innerHTML = posts.slice(0, Math.min(posts.length, 3)).map((_, i) => `
          <button type="button" class="dot ${i === 0 ? 'active' : ''}" data-slide="${i}"></button>
        `).join('');

        dotsContainer.querySelectorAll('.dot').forEach(dot => {
          dot.addEventListener('click', () => {
            currentIndex = parseInt(dot.dataset.slide);
            updateButtons();
            render();
          });
        });
      }

      updateButtons();
    }

    function updateButtons() {
      if (prevBtn) prevBtn.disabled = currentIndex === 0;
      if (nextBtn) nextBtn.disabled = currentIndex + 3 >= posts.length;
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentIndex > 0) {
          currentIndex -= 3;
          render();
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        if (currentIndex + 3 < posts.length) {
          currentIndex += 3;
          render();
        }
      });
    }

    render();
  });
</script>

<style>
  .publications {
    background-color: var(--bg-light);
    padding: 5rem 0;
  }

  .publications-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .section-title {
    margin: 0;
    font-size: 2.25rem;
    color: var(--primary-color);
    font-weight: 700;
    letter-spacing: -0.5px;
  }

  .publications-nav {
    display: flex;
    gap: 0.75rem;
  }

  .nav-btn {
    padding: 0.875rem 1.75rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.25s;
    border: 2px solid var(--accent-color);
    background: white;
    color: var(--accent-color);
    letter-spacing: 0.2px;
  }

  .nav-btn:hover:not(:disabled) {
    background: var(--accent-color);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(226, 135, 67, 0.25);
  }

  .nav-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    border-color: #ddd;
    color: #bbb;
  }

  .publications-carousel {
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .publications-track {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .publication-card {
    background: white;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid rgba(0,0,0,0.04);
    display: flex;
    flex-direction: column;
    height: 100%;
    opacity: 0.85;
    transform: scale(0.96);
  }

  .publication-card:hover {
    transform: translateY(-10px) scale(1);
    box-shadow: 0 15px 50px rgba(0,0,0,0.12);
    border-color: rgba(226, 135, 67, 0.2);
    opacity: 1;
  }

  .publication-card.active {
    border-color: var(--secondary-color);
    box-shadow: 0 10px 40px rgba(19, 64, 116, 0.15);
    opacity: 1;
    transform: scale(1);
    border-width: 2px;
  }

  .publication-image {
    height: 220px;
    overflow: hidden;
    background: var(--bg-light);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .publication-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 60%, rgba(0,0,0,0.1) 100%);
    pointer-events: none;
  }

  .publication-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s;
  }

  .publication-card:hover .publication-image img {
    transform: scale(1.05);
  }

  .publication-image-placeholder {
    height: 220px;
    background: linear-gradient(135deg, #f0f3f6 0%, #e8ecf1 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.5rem;
    color: #b8c0cc;
    transition: background 0.3s;
  }

  .publication-card:hover .publication-image-placeholder {
    background: linear-gradient(135deg, #e8ecf1 0%, #dce3eb 100%);
  }

  .publication-card-content {
    padding: 1.75rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .publication-date {
    font-size: 0.8rem;
    color: var(--accent-color);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .publication-date::before {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--accent-color);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .publication-title {
    color: var(--primary-color);
    font-size: 1.45rem;
    margin: 0 0 0.85rem 0;
    font-weight: 700;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .publication-excerpt {
    color: #666;
    line-height: 1.65;
    margin: 0;
    font-size: 0.95rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .publications-dots {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #e0e4e8;
    border: none;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 0;
  }

  .dot.active {
    background: var(--accent-color);
    width: 32px;
    border-radius: 6px;
    box-shadow: 0 2px 8px rgba(226, 135, 67, 0.3);
  }

  .dot:hover {
    background: var(--secondary-color);
  }

  .empty-posts {
    text-align: center;
    color: #888;
    font-size: 1.1rem;
    grid-column: 1 / -1;
    padding: 4rem 2rem;
    background: white;
    border-radius: 14px;
    border: 2px dashed #e0e4e8;
  }

  @media (max-width: 768px) {
    .publications {
      padding: 3.5rem 0;
    }

    .publications-header {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }

    .section-title {
      font-size: 1.8rem;
    }

    .publications-nav {
      justify-content: center;
      width: 100%;
    }

    .nav-btn {
      flex: 1;
      text-align: center;
      padding: 0.75rem 1rem;
    }

    .publications-track {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .publication-card {
      max-width: 500px;
      margin: 0 auto;
    }

    .publication-image {
      height: 180px;
    }

    .publication-image-placeholder {
      height: 180px;
    }

    .publication-card-content {
      padding: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .publications {
      padding: 2.5rem 0;
    }

    .publications-header {
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .section-title {
      font-size: 1.5rem;
    }

    .publications-nav {
      gap: 0.5rem;
    }

    .nav-btn {
      padding: 0.65rem 0.8rem;
      font-size: 0.85rem;
    }

    .publications-dots {
      gap: 0.5rem;
    }

    .dot {
      width: 10px;
      height: 10px;
    }

    .dot.active {
      width: 24px;
    }

    .publication-title {
      font-size: 1.25rem;
    }

    .publication-excerpt {
      font-size: 0.9rem;
    }
  }
</style>
